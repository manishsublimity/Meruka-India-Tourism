# Copy to .env and fill in. The admin panel (/admin) stays closed without ADMIN_PASSWORD. See DEPLOY.md.
ADMIN_USER=admin
ADMIN_PASSWORD=choose-a-long-password
SESSION_SECRET=long-random-text-at-least-32-characters
PORT=3000

# MySQL: the admin panel keeps all its data here (edits, drafts, history, users, enquiries, photos).
# On the first start the website makes the database and its tables by itself and fills them with the content in git
# (database/meruka-content.json). The MySQL user needs the right to create a database — on shared hosting
# (cPanel) make the database there first and give this user ALL PRIVILEGES on it.
DB_HOST=localhost
DB_PORT=3306
DB_USER=meruka_user
DB_PASSWORD=your-database-password
DB_NAME=meruka_cms

# …or everything in one line instead of the five above (leave it out to use them):
# DATABASE_URL=mysql://meruka_user:your-database-password@localhost:3306/meruka_cms

# Only on the computer where the content is written (never on the live server): keep database/meruka-content.json up
# to date after every save in the panel, so a push carries the content with the code.
# DB_SNAPSHOT=on
