# Copy to .env and fill in. The admin panel (/admin) stays closed without ADMIN_PASSWORD.
ADMIN_USER=admin
ADMIN_PASSWORD=choose-a-long-password
SESSION_SECRET=long-random-text-at-least-32-characters
PORT=3000

# MySQL: the admin panel keeps all its data here (edits, drafts, history, users, enquiries, photos).
# The tables are made by themselves on the first start; the database itself must exist.
DB_HOST=localhost
DB_PORT=3306
DB_USER=meruka_user
DB_PASSWORD=your-database-password
DB_NAME=meruka_cms

# …or everything in one line instead of the five above (leave it out to use them):
# DATABASE_URL=mysql://meruka_user:your-database-password@localhost:3306/meruka_cms
