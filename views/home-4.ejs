<%- include('partials/head') %>
<%
  const chipOff = 'font-size:14px;font-weight:600;padding:10px 18px;border-radius:13px;cursor:pointer;border:0;background:transparent;color:#5B6B82;white-space:nowrap;flex-shrink:0';
  const chipOn = 'font-size:14px;font-weight:600;padding:10px 18px;border-radius:13px;cursor:pointer;border:0;background:#336699;color:#fff;white-space:nowrap;flex-shrink:0';
  const starOff = 'font-size:13.5px;font-weight:700;padding:10px 15px;cursor:pointer;border:1px solid #DDE4EE;background:#F7F9FC;color:#33445E;font-family:inherit;transition:all .2s';
  const starOn = 'font-size:13.5px;font-weight:700;padding:10px 15px;cursor:pointer;border:1px solid #336699;background:#336699;color:#fff;font-family:inherit;transition:all .2s';
  const faqBox = on => 'border-top:1px solid #D5DEEA;background:' + (on ? '#fff' : 'transparent') + ';box-shadow:' + (on ? 'inset 3px 0 0 #336699' : 'none') + ';transition:background .25s';
  const faqIcon = on => 'width:36px;height:36px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:400;line-height:1;transition:all .3s;background:' + (on ? '#336699' : '#EBF2FE') + ';color:' + (on ? '#FFB81C' : '#336699') + ';transform:rotate(' + (on ? '45deg' : '0deg') + ')';
  const selStyle = 'width:100%;border:0;background:transparent;outline:none;font-size:15px;font-weight:700;color:#0B1B33;padding:0;cursor:pointer';
  const inputStyle = 'padding:14px 15px;border:1px solid #E2E8F0;background:#F7F9FC;outline:none;font-size:14.5px;border-radius:12px';
  const focus = 'border-color:#336699;background:#fff';
  const stepIcon = p => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' + p + '</svg>';
  const stepIcons = [
    stepIcon('<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>'),
    stepIcon('<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/><path d="M8.5 11h7M8.5 14h4"/>'),
    stepIcon('<circle cx="6" cy="18" r="2.2"/><circle cx="18" cy="6" r="2.2"/><path d="M8 18h6a3 3 0 0 0 0-6h-4a3 3 0 0 1 0-6h6"/>'),
    stepIcon('<path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6M9 16h3"/>'),
    stepIcon('<path d="M5 16V9l2-4h10l2 4v7"/><path d="M3 16h18v2H3z"/><circle cx="7.5" cy="18.5" r="1.5"/><circle cx="16.5" cy="18.5" r="1.5"/><path d="M5 10h14"/>'),
    stepIcon('<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>')
  ];
  const pkOff = 'font-size:14px;font-weight:600;padding:11px 18px;border-radius:99px;cursor:pointer;border:1px solid #E2E8F0;background:#fff;color:#33445E;white-space:nowrap;flex-shrink:0;transition:all .2s';
  const pkOn = 'font-size:14px;font-weight:600;padding:11px 18px;border-radius:99px;cursor:pointer;border:1px solid #336699;background:#336699;color:#fff;white-space:nowrap;flex-shrink:0;transition:all .2s';
  const ext = h => /^https?:/.test(h) ? ' target="_blank" rel="noopener"' : '';
%>
<div style="width:100%;overflow-x:clip;background:#F4F7FB">
<div id="mk-frame" class="ux v3 h4" style="container-type:inline-size;width:100%;margin:0 auto;background:#F4F7FB">

<%- include('partials/site-header', { active: 'Home', enquireHref: '/contactus#enquiry', variant: 'over' }) %>

<%
  // Hero slides: photo, place name, region line, and the tour list it opens
  // Main pictures in the client's order (6 Oct 2026): monuments, wildlife, festivals, mountains, desert, houseboat
  const hxSlides = [
    { src: '/photos/hero-taj-mahal.webp', alt: 'The Taj Mahal at sunset across the Yamuna, Agra', place: 'Taj Mahal, Agra', region: 'Golden Triangle', href: '/india-golden-triangle-tour', pos: '50% 45%' },
    { src: '/photos/hero-desert-camel.webp', alt: 'Camel safari on the sand dunes, Jaisalmer', place: 'Sand dunes, Jaisalmer', region: 'Desert', href: '/rajasthan-tours', pos: '50% 55%' },
    { src: '/photos/hero-tigers.webp', alt: 'Two Bengal tigers in the forest', place: 'Tiger safari', region: 'Wildlife', href: '/wildlife_tour', pos: '70% 40%' },
    { src: '/photos/hero-holi.webp', alt: 'Holi, the festival of colours', place: 'Holi festival', region: 'Fairs & Festivals', href: '/india_fair_festival_travelplan', pos: '50% 40%' },
    { src: '/photos/hero-ladakh.webp', alt: 'Mountains reflected in a high lake, Ladakh', place: 'Ladakh', region: 'Mountains', href: '/leh_ladakh_tours', pos: '50% 50%' },
    { src: '/photos/hero-hawa-mahal.webp', alt: 'Hawa Mahal, the Palace of Winds, Jaipur', place: 'Hawa Mahal, Jaipur', region: 'Rajasthan', href: '/rajasthan-tours', pos: '50% 40%' },
    { src: '/photos/hero-houseboat.jpg', alt: 'A houseboat on the Kerala backwaters', place: 'Kerala Backwaters', region: 'Kerala', href: '/southindia_kerala_tours', pos: '50% 50%' }
  ];
  // "06 Nights - 07 Days" -> "6N / 7D"
  // "06 Nights - 07 Days" -> "6 Nights / 7 Days" (shown with the tour's name)
  const longDur = v => { const m = String(v || '').match(/(\d+)\s*Nights?\s*[-–]\s*(\d+)\s*Days?/i); return m ? (+m[1]) + ' Nights / ' + (+m[2]) + ' Days' : (v || ''); };
  const shortDur = v => { const m = String(v || '').match(/(\d+)\s*Nights?\s*[-–]\s*(\d+)\s*Days?/i); return m ? (+m[1]) + 'N / ' + (+m[2]) + 'D' : (v || ''); };
%>


<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <filter id="lglass" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.008 0.012" numOctaves="2" seed="7" result="n"/>
    <feGaussianBlur in="n" stdDeviation="2" result="nb"/>
    <feDisplacementMap in="SourceGraphic" in2="nb" scale="38" xChannelSelector="R" yChannelSelector="G"/>
  </filter>
</svg>
<section id="top" class="h8" data-hero aria-roledescription="carousel" aria-label="Destinations">
  <div class="h8-slides">
    <% hxSlides.forEach((s, i) => { %>
    <figure class="h8-slide<%= i === 0 ? ' on' : '' %><%= s.flip ? ' flip' : '' %>" data-slide aria-hidden="<%= i !== 0 %>" data-place="<%= s.place %>" data-region="<%= s.region %>" data-href="<%= s.href %>">
      <img src="<%= s.src %>" alt="<%= s.alt %>" style="object-position:<%= s.pos %>"<%= i ? ' loading="lazy"' : ' fetchpriority="high"' %>>
    </figure>
    <% }) %>
    <button type="button" class="h4-nav h4-prev" data-h4-prev aria-label="Previous photo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 4-8 8 8 8"/></svg></button>
    <button type="button" class="h4-nav h4-next" data-h4-next aria-label="Next photo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 4 8 8-8 8"/></svg></button>
    <div class="h8-progress" aria-hidden="true"><i data-h-bar></i></div>
  </div>

  <div class="h8-in">
    <div class="h8-copy">
      <h1 class="h8-title" data-h4-head>One Country<br><span class="h4-l2">Many Worlds...</span></h1>
    </div>

  </div>
</section>



<section class="h8-stats" aria-label="Meruka India Tourism at a glance">
  <div class="b-wrap h8-stats-in">
    <div><b>20+</b><span>Years of rich experience</span></div>
    <div><b>1000+</b><span>Happy guests</span></div>
    <div><b><%= H2.totalTours %></b><span>Tour packages</span></div>
    <div><b class="h8-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 4.4 3.4 8.3 8 9 4.6-.7 8-4.6 8-9V6z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg></b><span>Private Tours — No Sharing</span></div>
  </div>
</section>

<section class="sb" aria-label="Plan my trip and search tours">
  <form class="sb-in" role="search" action="/itineraries" method="get">
    <label class="sb-field">
      <span class="sr-only">Search tours</span>
      <input type="search" name="q" placeholder="Search itineraries, destinations, monuments, etc…" autocomplete="off">
      <button type="submit" class="sb-go" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
    </label>
    <a href="/contactus" class="sb-btn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>Contact Us</a>
    <a href="<%= footer.wa %>" target="_blank" rel="noopener" class="sb-btn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>WhatsApp</a>
    <a href="#plan" class="sb-plan">Plan My Trip</a>
  </form>
</section>




<!-- ================= 1) Best Tour Packages in The Industry ================= -->
<section id="packages" class="bp bn h4-bn">
  <div class="b-wrap">
    <div class="h4-head">
      <div>
        <h2 class="h4-h2">Best Tour Packages <em>in The Industry</em></h2>
        <p class="h4-base">Offering Various Tour Packages in Each Sector.</p>
      </div>
      <a href="/itineraries" class="h4-all">View all packages <span>→</span></a>
    </div>

    <% const bnNights = c => c.nights ? (c.nights[0] === c.nights[1] ? c.nights[0] : c.nights[0] + '–' + c.nights[1]) + ' nights' : '';
       const bnMain = H2.categories.slice(0, 5), bnMore = H2.categories.slice(5); %>
    <div class="bn-grid">
      <% bnMain.forEach((c, i) => { %>
      <article class="bn-card<%= i === 0 ? ' bn-big' : '' %>">
        <img src="<%= c.img %>" alt="" loading="lazy">
        <span class="bn-shade" aria-hidden="true"></span>
        <a href="<%= c.url %>" class="bn-hit" tabindex="-1" aria-hidden="true"></a>
        <div class="bn-body">
          
          <h3 class="bn-title"><a href="<%= c.url %>" class="bn-link"><%= c.title %></a></h3>
          <% if (i === 0) { %>
          <p class="bn-line"><%= c.line %></p>
          <% } %>
          <div class="bn-foot">
            <% if (c.from) { %><span class="bn-price">From <b>$<%= c.from %></b> / person / day</span><% } %>
            <span class="bn-go" aria-hidden="true">→</span>
          </div>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="dz dz-a" aria-label="Seasonal offer">
  <div class="b-wrap dz-in">
    <div class="dz-main">
      <span class="dz-eyebrow">Seasonal offer</span>
      <p class="dz-t"><b class="dz-pct-sr">10%</b> discount on the tour packages booked from April to August!</p>
      <a href="#popular" class="dz-go">View tours <span aria-hidden="true">→</span></a>
    </div>
    <div class="dz-stub">
      <b class="dz-pct" aria-hidden="true">10%</b>
    </div>
  </div>
</section>

<!-- ================= 2) Most Popular Tours ================= -->
<section id="popular" class="mp">
  <div class="b-wrap">
    <div class="h4-head">
      <div>
        <h2 class="h4-h2">Most Popular Tours <em>of India</em></h2>
        <p class="h4-base">From Thar Desert of Rajasthan to Backwaters of Kerala.</p>
      </div>
      <a href="/itineraries" class="h4-all">View all packages <span aria-hidden="true">→</span></a>
    </div>
    <form class="tf tf4" id="tf" role="search" onsubmit="return false">
      <div class="tf4-bar">
        <label class="tf4-seg">
          <span class="tf4-l">Search by Sector</span>
          <select id="tf-cat">
            <option value="">All tour categories</option>
            <% H2.finder.forEach((g, i) => { %><option value="<%= i %>"><%= g.title %> (<%= g.tours.length %>)</option><% }) %>
          </select>
        </label>
        <label class="tf4-seg tf4-locked" data-tf-step2>
          <span class="tf4-l">Choose Your Tour Package</span>
          <select id="tf-tour" disabled>
            <option value="">Pick a tour category first</option>
          </select>
        </label>
        <label class="tf4-seg tf4-q">
          <span class="tf4-l">Search by Destinations</span>
          <input id="tf-q" type="search" placeholder="e.g. Jaipur, Kerala, Ladakh" autocomplete="off">
        </label>
        <button type="button" class="tf4-go" id="tf-reset" aria-label="Reset the finder" title="Reset">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
        </button>
      </div>
    </form>

    <p class="tf-status" id="tf-status" aria-live="polite">Our 6 most popular tours</p>
    <% // four stops along the route: start, two in between, end (repeats dropped)
       const ptStops = r => { const u = String(r || '').split(/\s+[-–]\s+/).map(x => x.trim()).filter((x, i, arr) => x && arr.indexOf(x) === i);
         if (u.length <= 4) return u; const n = u.length - 1; return [u[0], u[Math.round(n / 3)], u[Math.round(2 * n / 3)], u[n]]; }; %>
    <% const pqStops = r => String(r || '').split(/\s+[-–]\s+/).map(x => x.trim()).filter((x, i, arr) => x && arr.indexOf(x) === i);
       const pqNights = v => { const m = String(v || '').match(/(\d+)\s*Nights?/i); return m ? +m[1] : 0; }; %>
    <div class="pq-grid" id="tf-grid" data-wa="<%= footer.wa %>" data-card="pq">
      <% H2.popular.slice(0, 6).forEach(t => { const st = pqStops(t.route), n = pqNights(t.duration); %>
      <article class="pq-card">
        <a href="<%= t.href %>" class="pq-img" tabindex="-1" aria-hidden="true">
          <img src="<%= t.img %>" alt="" loading="lazy"<%- /taj-mahal/.test(t.img) ? ' class="pq-zoom"' : '' %>>
        </a>
        <div class="pq-mid">
          <h3 class="pq-name"><a href="<%= t.href %>"><%= t.name %></a></h3>
          <% if (t.duration) { %><p class="pq-nd"><%= longDur(t.duration) %></p><% } %>
          <p class="pq-stops"><svg class="pq-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg><% st.forEach((x, i) => { %><span<%- i >= 3 ? ' class="pq-more-x" hidden' : '' %>><%= x %></span><% }) %><button type="button" class="pq-more" data-pq-more aria-expanded="false"<%- st.length > 3 ? '' : ' hidden' %>>+<%= Math.max(st.length - 3, 0) %> more</button></p>
          <p class="pq-desc"><%= t.line || t.category %></p>
        </div>
        <div class="pq-cost">
          <div class="pq-price">
            <% if (t.from && n) { %><small>Starts From</small><b>$<%= (t.from * n).toLocaleString('en-US') %></b><% } else { %><small>Starts From</small><b class="pq-req">On request</b><% } %>
          </div>
          <div class="pq-btns">
            <a href="<%= t.href %>" class="pq-view">View Itinerary</a>
            <a href="<%= footer.wa %>?text=<%= encodeURIComponent('Hello Meruka, I am interested in the ' + t.name + '.') %>" target="_blank" rel="noopener" class="pq-wa" aria-label="Ask on WhatsApp" title="Ask on WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg></a>
          </div>
        </div>
      </article>
      <% }) %>
    </div>
    <p class="pq-foot-note"><b>Note:</b> Tour cost is for a minimum of 2 persons travelling together · 3-star hotels, 1 double room on twin sharing with breakfast.</p>
    <div class="tf-empty is-hidden" id="tf-empty">No packages match. <button type="button" id="tf-clear">Show popular tours</button></div>
  </div>
</section>

<!-- ================= 3) $170 per couple per day ================= -->
<section id="own-tour" class="c6">
  <div class="b-wrap">
    <div class="c6-head">
      <div>
        <h2 class="h4-h2 c6-h">Chalk Out Your Own <em>Private Tour</em></h2>
        <p class="c6-base">Your trip, your way.</p>
      </div>
    </div>
    <div class="c6-parts">
      <div class="c6-part c6-price">
        <div class="c6-amt"><span>USD</span><b>170</b></div>
        <p>Per Couple Per Day onwards</p>
      </div>
      <span class="c6-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 6 6 6-6 6"/><path d="m13 6 6 6-6 6"/></svg></span>
      <div class="c6-part"><p>Inclusive of 3-star hotel accommodation with breakfast, private A/C car with English speaking driver throughout the tour for all pickups, sightseeing, intercity travel, excursions and other services as specified.</p></div>
      <span class="c6-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 6 6 6-6 6"/><path d="m13 6 6 6-6 6"/></svg></span>
      <div class="c6-part"><p>The tour packages can be upgraded to 4, 5 star &amp; 5-star deluxe hotels and also can be customized in terms of number of days, destinations and sightseeing according to your budget and requirement.</p></div>
      <span class="c6-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 6 6 6-6 6"/><path d="m13 6 6 6-6 6"/></svg></span>
      <div class="c6-part c6-acts">
        <div class="c3-actions">
          <a href="#plan" class="c3-btn c3-gold">Tell Us Your Plan <span aria-hidden="true">→</span></a>
          <a href="<%= footer.wa %>" target="_blank" rel="noopener" class="c3-btn c3-line"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>WhatsApp</a>
          <a href="mailto:<%= footer.hq.email %>" class="c3-btn c3-line">Email us</a>
        </div>
      </div>
    </div>
  </div>
</section>



<section id="destinations" class="h4-regions">
  <div style="max-width:1408px;margin:0 auto;padding:0 24px">
    <div class="h4-head">
      <div>
        <h2 class="h4-h2">Four Regions. <em>Four Different Countries.</em></h2>
        <p class="h4-base">The Grace of Geography.</p>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(400px,100%),1fr));grid-auto-rows:300px;grid-auto-flow:dense;gap:14px">
      <% H2.regions.forEach((r, i) => { %>
      <div class="h-region-<%= i %>">
        <div class="rg rg2">
          <img src="<%= r.img %>" alt="" loading="lazy" class="rg-img">
          <span class="rg-shade"></span>
          <div class="rg-body">
            <a href="<%= r.href %>" class="rg-name rg2-main"><%= r.name %></a>
            <span class="rg-kicker h4-kick"><%= r.kicker %></span>
            <p class="rq-cities"><span class="rq-l">Popular cities:</span> <% r.cities.forEach((c, ci) => { %><a href="<%= c[1] %>"><%= c[0] %></a><% if (ci < r.cities.length - 1) { %><i aria-hidden="true">·</i> <% } %><% }) %></p>
          </div>
        </div>
      </div>
      <% }) %>
    </div>

    <!-- States to Explore: attached to the region grid so both read as one section -->
    <% const seBy = {}; d.stateGroups.forEach(g => g.states.forEach(s => { seBy[s[0]] = { href: s[1], img: s[2], region: g.region }; }));
       const seOrder = ['Rajasthan','Kerala','Himachal Pradesh','Uttarakhand','Goa','Sikkim','Jammu & Kashmir','Gujarat','Madhya Pradesh','Maharashtra','Tamil Nadu','Karnataka','Uttar Pradesh','Odisha','Assam','West Bengal','Andhra Pradesh','Telangana','Punjab','Bihar','Ladakh']; %>
    <div id="states" class="sx">
      <h3 class="sx-title">States of India</h3>
      <p class="sx-list">
        <% seOrder.forEach((n, i) => { const s = seBy[n]; %><a href="<%= s.href %>"><%= n %></a><% if (i < seOrder.length - 1) { %><span aria-hidden="true"> · </span><% } %>
        <% }) %>
      </p>
    </div>
  </div>
</section>

<section id="guide" class="g2">
  <div class="g2-wrap">
    <div class="h4-head">
      <div>
        <h2 class="h4-h2">India <em>Travel Guide</em></h2>
        <p class="h4-base">Travel with peace of mind — everything we are asked before a first trip, answered plainly.</p>
      </div>
      <a href="/travelers_guide" class="h4-all">Open the full guide <span aria-hidden="true">→</span></a>
    </div>

    <div class="g2-grid">
      <div class="g2-season">
        <img src="/photos/guide-main.webp" alt="A young woman in a hat by a mountain lake" loading="lazy">
        <div class="g2-season-copy">
          <span class="g2-tag">WHEN TO COME</span>
          <div class="g2-season-t">The Country for All Seasons</div>
          <div class="g2-season-p">September to March is the best time.</div>
        </div>
      </div>
      <% d.guideCols.forEach((g, gi) => { %>
      <div class="g2-card">
        <div class="g2-card-img"><img src="<%= H2.guideImgs[gi] %>" alt="" loading="lazy"></div>
        <div class="g2-card-head">
          <span class="g2-card-t"><%= g.title %></span>
        </div>
        <ul>
          <% g.items.forEach(it => { const h = d.to(it, 'guide'); %>
          <li><a href="<%= h %>"<%- ext(h) %>><span><%= it %></span><i aria-hidden="true">→</i></a></li>
          <% }) %>
        </ul>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section id="reviews" class="rm r1">
  <% const r1All = d.testimonials.all, r1Row = r1All.slice(0, 16); %>
  <div class="rm-wrap rv3-head">
    <div class="rv3-intro">
      <h2 class="h4-h2">Guest <em>Reviews</em></h2>
      <p class="h4-base">Stories You’ll Tell Forever.</p>
    </div>
    <div class="rv3-proof">
      <div class="rv3-avs" aria-hidden="true"><% r1All.slice(0, 4).forEach(t => { %><span><%= t.initials %></span><% }) %><span class="rv3-more">+<%= r1All.length - 4 %></span></div>
      <div class="rv3-nums">
        <p><b><%= r1All.length %></b> guest testimonials</p>
        <p><b>60%</b> of new guests come through friends and returning families.</p>
        <p><b>97.60%</b> Tour Success Rate</p>
      </div>
    </div>
  </div>

  <div class="rm-rows" aria-label="Guest testimonials">
    <div class="rm-row">
      <div class="rm-track r1-track">
        <% [0, 1].forEach(copy => { r1Row.forEach(t => { %>
        <figure class="rm-card r1-card"<%- copy ? ' aria-hidden="true"' : '' %>>
          <span class="r1-tour"><%= t.tour %></span>
          <blockquote class="rm-quote"><%= t.quote %></blockquote>
          <figcaption class="rm-who">
            <span class="rm-av"><%= t.initials %></span>
            <span class="rm-meta"><b><%= t.name %></b><small><%= t.country %></small></span>
          </figcaption>
        </figure>
        <% }) }) %>
      </div>
    </div>
  </div>

  <p class="rm-wrap rv3-hope">“Hope to see your reviews here.”</p>
  <div class="rm-wrap rm-foot">
    <button type="button" class="rm-pause" aria-pressed="false"><span class="rm-pause-ic" aria-hidden="true"></span><span class="rm-pause-t">Pause</span></button>
    <a href="<%= d.testimonials.href %>" class="rm-all">Read all testimonials <span>→</span></a>
  </div>
</section>

<section id="why" class="wn">
  <div class="b-wrap wn-grid">
    <div class="wn-media">
      <div class="wn-photo"><img src="/photos/handshake-deal.webp" alt="Two people shaking hands across a desk" loading="lazy"></div>
      <figure class="wn-quote">
        <blockquote>“The guest is the only Boss of our company; this is our prime duty and commitment to always provide the best services.”</blockquote>
        <figcaption><span class="mlogo mlogo-blue wn-logo" aria-hidden="true"></span><span><b>Ashok Pareek</b>Founder, Meruka India Tourism Service</span></figcaption>
      </figure>
    </div>

    <div class="wn-copy">
      <h2 class="h4-h2">Why to <em>Choose Us?</em></h2>
      <p class="h4-base">“Always give people more than what they expect to get.”</p>
      <p class="wn-intro">Founded in 2001 to do one thing properly: look after overseas travellers inside India. No domestic groups, no merged coaches — your party, your car, your pace, with our own ground teams in every state you pass through.</p>
      <% const wvTick = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>'; %>
      <ul class="wv-list">
        <li><span class="wv-ic"><%- wvTick %></span><div><b>Routed by hand</b><span>Distances, driving hours and city order worked out for your party — never a template.</span></div></li>
        <li><span class="wv-ic"><%- wvTick %></span><div><b>Hotels contracted direct</b><span>See the hotel name and room category before you pay.</span></div></li>
        <li><span class="wv-ic"><%- wvTick %></span><div><b>Transparent to the last line</b><span>What is quoted is exactly what arrives.</span></div></li>
        <li><span class="wv-ic"><%- wvTick %></span><div><b>Full inbound specialists</b><span>20+ years of looking after overseas guests across India.</span></div></li>
      </ul>

      <div class="wn-contact">
        <a href="<%= footer.wa %>" target="_blank" rel="noopener" class="wn-btn wn-wa">WhatsApp</a>
        <a href="mailto:<%= footer.hq.email %>" class="wn-btn">Email us</a>
        <a href="tel:<%= footer.hq.phones[0].replace(/[^0-9+]/g, '') %>" class="wn-btn">Call <%= footer.hq.phones[0] %></a>
      </div>
    </div>
  </div>
</section>


<section id="faq" class="fq bf">
  <div class="fq-wrap">
    <div class="fq-intro">
      <h2 class="h4-h2">FAQs</h2>
      <p class="h4-base">Assistance on every step you take.</p>
      <div class="fq5">
        <div class="fq5-img"><img src="/photos/faqs.webp" alt="A question mark on a bed of sand" loading="lazy"></div>
        <div class="fq5-body">
          <b class="fq5-t">Still have a question?</b>
          <p>A planner answers, not a bot.</p>
          <a href="tel:<%= footer.hq.phones[0].replace(/[^0-9+]/g, '') %>" class="fq5-line"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg><%= footer.hq.phones[0] %></a>
          <a href="mailto:<%= footer.hq.email %>" class="fq5-line"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14"/><path d="m3 7 9 6 9-6"/></svg><%= footer.hq.email %></a>
          <a href="#plan" class="fq5-cta">Plan My Trip <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
    <div class="fq-list">
      <% d.faqs.forEach((f, i) => { const on = i === 0; %>
      <div class="faq" data-on="<%= faqBox(true) %>" data-off="<%= faqBox(false) %>" style="<%= faqBox(on) %>">
        <button class="fq-q" aria-expanded="<%= on %>">
          <b class="fq-n"><%= String(i + 1).padStart(2, '0') %></b>
          <span class="fq-q-t"><%= f.q %></span>
          <span class="faq-icon" data-on="<%= faqIcon(true) %>" data-off="<%= faqIcon(false) %>" style="<%= faqIcon(on) %>">+</span>
        </button>
        <div class="faq-a fq-a<%= on ? '' : ' is-hidden' %>"><%= f.a %></div>
      </div>
      <% }) %>
      <div class="faq fq-how" id="process" data-on="<%= faqBox(true) %>" data-off="<%= faqBox(false) %>" style="<%= faqBox(false) %>">
        <button class="fq-q" aria-expanded="false">
          <b class="fq-n"><%= String(d.faqs.length + 1).padStart(2, '0') %></b>
          <span class="fq-q-t">How we work — from your first email to the airport wave-off</span>
          <span class="faq-icon" data-on="<%= faqIcon(true) %>" data-off="<%= faqIcon(false) %>" style="<%= faqIcon(false) %>">+</span>
        </button>
        <div class="faq-a fq-a is-hidden">
          <p class="fq-how-p">No deposit until the whole plan — routing, hotels by name, every cost — is approved by you.</p>
          <ol class="fq-steps">
            <% d.steps.forEach(s => { %>
            <li><span class="fq-step-n"><%= s.n %></span><span class="fq-step-b"><small><%= s.when %></small><b><%= s.title %></b><%= s.body %></span></li>
            <% }) %>
          </ol>
        </div>
      </div>
    </div>
  </div>

</section>

<section id="plan" class="pv pz">
  <div class="b-wrap">
    <div class="pz-head">
      <div>
        <div class="pz-title"><h2 class="h4-h2 pz-h">Plan Your <em>Trip</em></h2>
        <p class="pz-q">“The journey of a thousand miles begins with one step.”</p></div>
      </div>
      <ul class="pz-trust">
        <li>Reply &lt; 24h</li><li>No obligation</li><li>No deposit</li><li>Details never shared</li>
      </ul>
    </div>
    <div class="pz-body">
      <div id="plan-sent" class="is-hidden pl-sent">
          <div class="pl-sent-tick">✓</div>
          <div class="pl-sent-t">Enquiry received</div>
          <div class="pl-sent-p">A planner will write within one working day. Urgent? Call <a href="tel:<%= footer.hq.phones[0].replace(/[^0-9+]/g, '') %>"><%= footer.hq.phones[0] %></a>.</div>
        </div>
      <form id="plan-form" novalidate class="pz-form">
        <div class="pz-row">
          <label class="pv5-f"><span class="sr-only">Full name</span><input name="name" class="pv-in" placeholder="Full name" autocomplete="name"></label>
          <label class="pv5-f"><span class="sr-only">Email address</span><input name="email" type="email" class="pv-in" placeholder="Email address" autocomplete="email"></label>
          <label class="pv5-f"><span class="sr-only">Country</span><select name="country" class="pv-in"><% d.countries.forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %></select></label>
          <label class="pv5-f"><span class="sr-only">Arrival date</span><input name="date" type="date" class="pv-in"></label>
          <label class="pv5-f"><span class="sr-only">Travellers</span><select name="travellers" class="pv-in"><% d.paxOpts.forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %></select></label>
          <label class="pv5-f"><span class="sr-only">Duration</span><select name="duration" class="pv-in"><% d.filters.days.opts.forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %></select></label>
        </div>
        <div class="pz-row2">
          <div class="pz-stars"><span class="pz-l">Hotel</span><div class="pv-stars">               <% d.starChips.forEach(x => { %>               <button type="button" class="star" data-star="<%= x %>" data-on="<%= starOn %>" data-off="<%= starOff %>" style="<%= x === d.defaultStar ? starOn : starOff %>"><%= x %></button>               <% }) %>             </div></div>
          <label class="pz-msg"><span class="sr-only">Your trip</span><textarea name="message" rows="1" class="pv-in pv-ta" placeholder="Destinations or tour code in mind — e.g. IGT-551 plus the Kerala backwaters, slow pace."></textarea></label>
          <button type="submit" class="pv-submit pz-go">Send My Enquiry <span aria-hidden="true">→</span></button>
        </div>
        <div id="plan-err" class="is-hidden pl-err"></div>
      </form>
    </div>
  </div>
</section>


<%- include('partials/site-footer', { extras: true }) %>

</div>
</div>

<script>window.TOUR_FINDER = <%- JSON.stringify(H2.finder).replace(/</g, '\\u003c') %>;</script>
<script src="/js/home-2.js" defer></script>
<script src="/js/home-4.js" defer></script>
</body>
</html>
