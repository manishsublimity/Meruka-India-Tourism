<%- include('partials/head') %>
<%
  const enquire = '/contactus#enquiry';
  const heroImg = photoFor([d.heading, d.url]);
  // Region pages open with fact lines — "<p><strong>Location:</strong> Above the Tropic of Cancer</p>".
  // They are shown as fact cards above the text (same wording); the rest of the article follows.
  const FACT = /^\s*<p>\s*<strong>([^<]{2,40}?)\s*<\/strong>\s*([\s\S]*?)<\/p>/;
  let body = d.html, m;
  const facts = [];
  while (facts.length < 8 && (m = body.match(FACT)) && /:\s*$/.test(m[1])) {
    facts.push({ label: m[1].replace(/:\s*$/, ''), value: m[2].trim() });
    body = body.slice(m[0].length);
  }
  if (facts.length < 2) { facts.length = 0; body = d.html; }
  // a "Read More" link at the end of a paragraph becomes the site's blue outline button
  body = body.replace(/<a ([^>]*)>\s*Read More\s*<\/a>(\s*<\/p>)/gi, '<a class="ar-more" $1>Read More <span aria-hidden="true">→</span></a>$2');
  // loose text between paragraphs on some originals (Goa) becomes a paragraph of its own
  body = body.replace(/<\/p>\s*([^<\s][^<]*?)\s*(?=<p[\s>]|<h[1-6][\s>])/g, '</p><p>$1</p>');
  const chips = v => !/</.test(v) ? v.split(/\s*,\s*/).filter(Boolean) : null;
  const factIcons = {
    location: '<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
    cities: '<path d="M3 21h18M5 21V8l6-3v16M11 21V3l8 4v14"/><path d="M8 11h.01M8 14h.01M14 10h.01M14 13h.01M14 16h.01"/>',
    holy: '<path d="M12 3c-3 4-3 6 0 9 3-3 3-5 0-9z"/><path d="M5 21h14M7 21v-5h10v5M4 16h16"/>',
    other: '<path d="m12 3 2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.6 6.6 19.5l1.2-6-4.5-4.2 6.1-.7z"/>'
  };
  // Destination guides (Delhi, Jaipur, Kerala …): pages with "Places of Interest" that are not region overviews.
  // The words stay the same; article.js lays them out as facts, place cards and travel cards.
  // Goa and the wildlife parks have Excursions / Reach but no "Places of Interest"; four state pages are only
  // an introduction and a section per city, like Karnataka — all of them use the same destination layout.
  const DEST_STATES = ['/Jammu-Kashmir', '/Madhya-Pradesh', '/rajasthan', '/Lakshadweep'];
  const isDest = !facts.length && (/Places of Interest/i.test(d.html) || /<h[34][^>]*>\s*(Excursions|Reach)/i.test(d.html) || DEST_STATES.includes(d.url));
  const place = String(d.heading).replace(/\s*Tourism$/i, '').trim();
  const tours = isDest ? toursFor(place) : [];
  // a different photo for every tour card (and none that the page already shows): the tour's own
  // photo, else one for a stop on its route other than this place, else the card photo
  const usedImg = new Set((d.listings && d.listings.regions || []).map(r => r.img));
  const tourImg = t => {
    const stops = String(t.route || '').split(/\s+[-–]\s+/).filter(x => !new RegExp(place, 'i').test(x));
    const pool = [t.img].concat(photoChoices(t.name), ...stops.map(x => photoChoices(x)), [photoForCard(t.name, t.route, place)]).filter(Boolean);
    const spare = ['jaipur', 'udaipur', 'jodhpur', 'kerala', 'goa', 'ladakh', 'varanasi', 'madurai', 'mysore', 'gujarat', 'darjeeling', 'delhi', 'tiger', 'buddh', 'north india'].flatMap(k => photoChoices(k));
    const pick = pool.concat(spare).find(x => !usedImg.has(x)) || pool[pool.length - 1];
    usedImg.add(pick); return pick;
  };
  const pad = n => (n < 10 ? '0' : '') + n;
  const iconFor = l => /locat/i.test(l) ? factIcons.location : /cit/i.test(l) ? factIcons.cities : /holy/i.test(l) ? factIcons.holy : factIcons.other;
%>
<div style="width:100%;overflow-x:clip;background:#F4F7FB">
<div id="mk-frame" class="<%= typeof frameClass !== 'undefined' ? frameClass : '' %>" style="container-type:inline-size;width:100%;background:#F4F7FB">

<%- include('partials/page-header', { nav: d.nav, enquireHref: enquire, active: isDest || facts.length ? 'Destinations' : '' }) %>

<%- include('partials/photo-hero', { title: d.heading, img: d.heroSrc, alt: d.heroAlt || '', crumbs: d.breadcrumb }) %>

<%# (15 Oct 2026) region facts are in the sidebar ("At a glance" card, the same card as the destination pages' Quick facts) %>

<section id="content" class="ar az <%= facts.length ? 'az-b ar-region' : isDest ? 'az-a ar-dest' : 'az-a' %>">
  <div class="az-wrap">
  <%# (15 Oct 2026) no "Discover …" / "Travel guide" heading here: the page title sits right above, under the banner %>
  <div class="ar-wrap<%= facts.length ? ' ar-has-aside2' : '' %>" id="ar-wrap">
    <aside class="ar-side is-hidden" id="ar-side">
      <div class="ar-toc-box">
        <span class="ar-toc-label">On this page</span>
        <nav id="ar-toc" aria-label="On this page"></nav>
        <a href="<%= enquire %>" class="ar-cta">Plan a trip <span>→</span></a>
      </div>
    </aside>
    <article class="ar-body">
      <%# (16 Oct 2026) a broken "<div" left at the end by the import, and empty paragraphs / blocks left at the end of the text, are
          dropped (they only added space) %>
      <div class="prose"><%- rewriteHtml(body).replace(/<div\s*$/i, '').replace(/(<\/p>)\s*<\/a>\s*<\/p>\s*$/i, '$1').replace(/(\s*<(p|div)\b[^>]*>(\s|&nbsp;|<br\s*\/?>)*<\/\2>)+\s*$/i, '') %></div>
    </article>
    <% if (facts.length) { %>
    <aside class="ar-aside2 rg-aside">
      <div class="ar-a2-card dx-qf rg-qf">
        <p class="ar-a2-h">At a <em>glance</em></p>
        <div class="dx-facts">
          <% facts.forEach(f => { const list = chips(f.value); %>
          <div class="dx-fact"><span class="dx-fact-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- iconFor(f.label) %></svg></span><span class="dx-fact-t"><small><%= f.label %></small><b><% if (list && list.length > 1) { %><%- list.join(', ') %><% } else { %><%- f.value %><% } %></b></span></div>
          <% }) %>
        </div>
      </div>
    </aside>
    <% } %>
  </div>
  </div>
</section>

<% if (tours.length) { %>
<section class="az az-b dx-tours" aria-label="Tours">
  <div class="az-wrap">
    <div class="az-head h4-head">
      <div><h2 class="h4-h2">Tours that include <em><%= place %></em></h2></div>
      <a href="/itineraries" class="h4-all">View all tours <span>→</span></a>
    </div>
    <div class="tc-grid dx-tc-grid">
      <% tours.forEach((t, i) => { const rp = t.route ? t.route.split(/\s+([-–])\s+/) : []; const stops = rp.filter((x, j) => j % 2 === 0); %>
      <a class="tc" href="<%= t.href %>">
        <span class="tc-img"><img src="<%= tourImg(t) %>" alt="" loading="lazy"></span>
        <span class="tc-body">
          <% if (t.duration) { %><span class="tc-dur"><%= t.duration %></span><% } %>
          <h3 class="tc-name"><%= t.name %></h3>
          <% if (stops.length) { %><span class="tc-route"><% stops.slice(0, 6).forEach((st, j) => { %><span><%= st %></span><% if (j < Math.min(stops.length, 6) - 1) { %><i>-</i><% } %><% }) %><% if (stops.length > 6) { %><i>…</i><% } %></span><% } %>
          <span class="tc-go">View itinerary <b>→</b></span>
        </span>
      </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (facts.length || isDest) { %>
<section class="az az-a az-end">
  <div class="az-wrap az-cta">
    <span class="az-no az-no-c"><%= d.heading %></span>
    <p class="az-cta-lead">Tell us which places you'd like to see — <em>we'll draw the route.</em></p>
    <div class="az-acts">
      <a href="/plan-my-trip" class="ph-btn ph-btn-gold">Plan My Trip <span>→</span></a>
      <a href="<%= footer.wa %>" target="_blank" rel="noopener" class="az-btn-line">WhatsApp us <span>→</span></a>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/popular-tours', { current: d.url }) %>

<%- include('partials/explore-india', { current: d.url }) %>

<%- include('partials/page-footer', { footCols: d.footCols, enquireHref: enquire }) %>

</div>
</div>
<script src="/js/article.js" defer></script>
</body>
</html>
