<%- include('partials/head') %>
<%
  const enquire = '/contactus#enquiry';
  // (21 Oct 2026, client) the longest reviews first, then the shorter ones; one-line reviews last
  const all = T.all.slice().sort((a, b) => b.quote.length - a.quote.length);
  // Filter groups by the tour each guest took (keywords in the tour name)
  const GROUPS = [
    ['golden-triangle', 'Golden Triangle', /golden triangle/i],
    ['rajasthan', 'Rajasthan', /rajasthan|jaisalmer|udaipur|jaipur/i],
    ['south', 'South India & Kerala', /south|kerala|karnataka|tamil|goa/i],
    ['north', 'North India & Himalaya', /north|himachal|ladakh|leh|kashmir|uttar|sikkim|darjeeling|east|arunachal/i],
    ['spiritual', 'Religious & Buddhist', /religious|pilgrim|buddh|temple|spiritual|yoga/i]
  ];
  const groupsOf = t => GROUPS.filter(g => g[2].test(t.tour)).map(g => g[0]);
  const counts = Object.fromEntries(GROUPS.map(g => [g[0], all.filter(t => g[2].test(t.tour)).length]));
  const extra = '<div class="ph-facts"><span><b>' + all.length + '</b> guest reviews</span></div>'
    + '<div class="ph-actions"><a href="#reviews" class="ph-btn ph-btn-gold">Read the reviews <span>↓</span></a><a href="' + enquire + '" class="ph-btn ph-btn-line">Plan your trip <span>→</span></a></div>';
%>
<div style="width:100%;overflow-x:clip;background:#F4F7FB">
<div id="mk-frame" class="<%= typeof frameClass !== 'undefined' ? frameClass : '' %>" style="container-type:inline-size;width:100%;background:#F4F7FB">

<%- include('partials/page-header', { nav: d.nav, enquireHref: enquire, active: 'Guest Reviews' }) %>

<%- include('partials/photo-hero', { title: 'Guest Reviews', img: d.heroSrc, alt: d.heroAlt || '', crumbs: [{ label: 'Home', href: '/' }, { label: 'Guest Reviews' }] }) %>

<%# (16 Oct 2026) no "In our guests' words" heading: the page title sits right above; the intro follows it %>
<section class="az az-a tm-top">
  <div class="az-wrap az-row">
    <div class="az-main">
      <p class="az-lead"><%= T.intro %></p>
      <%- include('partials/review-proof', { all: all }) %>
    </div>
  </div>
</section>

<section id="reviews" class="tm az az-b">
  <div class="az-wrap">
    <%# (16 Oct 2026) the heading, the tour filter and the search are removed at the client's request: the reviews start here %>
    <%# (16 Oct 2026, client's pick U) no "Showing 9 of 72" line; an editorial card — a big gold quote mark, the guest's
        words large in the serif, then the guest (initials, name, details) and the tour they took; more reviews load
        by themselves as the visitor scrolls %>
    <%# (18 Oct 2026, client) two rows of four to start, then "View more reviews"; no picture or initials %>
    <div class="tm-grid tm2 tm3 tm-four" id="tm-grid">
      <% all.forEach((t, i) => { %>
      <figure class="tm-card<%= i >= 8 ? ' is-hidden' : '' %>" data-g="<%= groupsOf(t).join(' ') %>" data-search="<%= (t.name + ' ' + t.details.join(' ') + ' ' + t.tour + ' ' + t.route).toLowerCase() %>">
        <blockquote class="tm-quote" id="tm-q-<%= i %>"><%= t.quote %></blockquote>
        <button type="button" class="tm-more" aria-expanded="false" aria-controls="tm-q-<%= i %>" hidden>Read more</button>
        <figcaption class="tm-who">
          <span class="rv-foot"><% if (t.tour) { %><span class="rv-tour"><%= t.tour %></span><% } %><span class="rv-guest"><b><%= t.name %></b><% if (t.details.length) { %><small><%= t.details.join(', ') %></small><% } %></span></span>
        </figcaption>
      </figure>
      <% }) %>
    </div>

    <div class="tm-empty is-hidden" id="tm-empty">No reviews match your search. <button type="button" id="tm-reset">Show all</button></div>
    <div class="tm-foot"><button type="button" class="tm-load" id="tm-load">View more reviews <span>↓</span></button></div>
  </div>
</section>


<%- include('partials/explore-india', { current: '/testimonials', skipRegions: true, skipGuide: true }) %>

<%- include('partials/page-footer', { footCols: d.footCols, enquireHref: enquire }) %>

</div>
</div>
<script src="/js/testimonials.js" defer></script>
</body>
</html>
