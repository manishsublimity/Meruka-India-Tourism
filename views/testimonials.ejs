<%- include('partials/head') %>
<%
  const enquire = '/contactus#enquiry';
  // (23 Oct 2026, client's reference reviews-4) reviews of about 5-6 lines (320-460 characters) first, longest first;
  // then the others, longest first
  const LO = 320, HI = 460, byLen = (a, b) => b.quote.length - a.quote.length, fits = t => t.quote.length >= LO && t.quote.length <= HI;
  const all = T.all.filter(fits).sort(byLen).concat(T.all.filter(t => !fits(t)).sort(byLen));
%>
<div style="width:100%;overflow-x:clip;background:#F4F7FB">
<div id="mk-frame" class="<%= typeof frameClass !== 'undefined' ? frameClass : '' %>" style="container-type:inline-size;width:100%;background:#F4F7FB">

<%- include('partials/page-header', { nav: d.nav, enquireHref: enquire, active: 'Guest Reviews' }) %>

<%- include('partials/photo-hero', { title: 'Guest Reviews', img: d.heroSrc, alt: d.heroAlt || '', crumbs: [{ label: 'Home', href: '/' }, { label: 'Guest Reviews' }] }) %>

<%# (16 Oct 2026) no "In our guests' words" heading: the page title sits right above; the intro follows it %>
<section class="az az-a tm-top">
  <div class="az-wrap az-row">
    <div class="az-main">
      <p class="az-lead"><%= T.intro %></p>
      <%- include('partials/review-proof', { all: all }) %>
    </div>
  </div>
</section>

<%# (23 Oct 2026, client's reference reviews-4, on the site's own design) two cards in a row, the same card as the home
    page reviews: the review (six lines, then "… View more"), and at the foot the tour (left) and the guest (right). Six to start, six more per
    "View more reviews". Every review is in the page itself (for search engines); the script only shows and hides. %>
<section id="reviews" class="rv4">
  <div class="az-wrap">
    <div class="rv4-grid" id="rv4-grid">
      <% all.forEach((t, i) => { %>
      <article class="rv4-card"<%= i >= 6 ? ' hidden' : '' %>>
        <div class="rv4-tw"><p class="rv4-tx" id="rv4-q-<%= i %>"><%= t.quote %></p><button type="button" class="rv4-vm" aria-expanded="false" aria-controls="rv4-q-<%= i %>" hidden>… View more</button></div>
        <footer class="rv-foot"><% if (t.tour) { %><span class="rv-tour"><%= t.tour %></span><% } %><span class="rv-guest"><b><%= t.name %></b><% if (t.details.length) { %><small><%= t.details.join(', ') %></small><% } %></span></footer>
      </article>
      <% }) %>
    </div>
    <div class="rv4-more"<%= all.length <= 6 ? ' hidden' : '' %>><button type="button" class="ph-btn rv4-load" id="rv4-load">View more reviews</button></div>
  </div>
</section>


<%- include('partials/explore-india', { current: '/testimonials', skipRegions: true, skipGuide: true }) %>

<%- include('partials/page-footer', { footCols: d.footCols, enquireHref: enquire }) %>

</div>
</div>
<script src="/js/testimonials.js" defer></script>
</body>
</html>
