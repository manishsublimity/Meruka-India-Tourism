<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<%# (23 Oct 2026) Google Translate: when a language other than English is picked (googtrans cookie), the
    translator loads here in the head and the page stays hidden until it has been translated, so the English
    text never flashes on the next page; shown anyway after 6s if Google is slow; a small spinner meanwhile %>
<style>html.gt-wait body{opacity:0 !important}html.gt-show body{transition:opacity .15s ease}
html.gt-wait::after{content:"";position:fixed;left:50%;top:50%;width:34px;height:34px;margin:-17px 0 0 -17px;border:3px solid #D6E2EF;border-top-color:#336699;border-radius:50%;animation:gt-spin .8s linear infinite;z-index:2147483647}
@keyframes gt-spin{to{transform:rotate(360deg)}}
/* (23 Oct 2026, client doc) page text and photos not easy to copy; form fields work as usual */
#mk-frame{-webkit-user-select:none;user-select:none}
#mk-frame :is(input,textarea,select,[contenteditable]){-webkit-user-select:text;user-select:text}
#mk-frame img{-webkit-user-drag:none;-webkit-touch-callout:none}</style>
<script>
(function () {
  var lang = (document.cookie.match(/(?:^|; )googtrans=\/en\/([^;]+)/) || [])[1];
  if (!lang) return;
  var html = document.documentElement, done = false, quiet;
  html.classList.add('gt-wait');
  function show() { if (done) return; done = true; html.classList.add('gt-show'); html.classList.remove('gt-wait'); }
  setTimeout(show, 6000);
  // Google marks <html> as translated, then fills the text in batches (each translated bit wrapped in <font>):
  // show a moment after the page's main heading is translated (the first batch covers the top of the page)
  var watch = new MutationObserver(function () {
    if (quiet || !/translated-/.test(html.className)) return;
    var head = document.querySelector('#mk-frame h1') || document.querySelector('#mk-frame h2');
    if (head && !head.querySelector('font')) return;
    watch.disconnect(); quiet = setTimeout(show, 100);
  });
  watch.observe(html, { attributes: true, childList: true, characterData: true, subtree: true });
  window.googleTranslateElementInit = function () {
    var start = function () {
      var holder = document.createElement('div'); holder.id = 'google_translate_element'; holder.style.display = 'none'; document.body.appendChild(holder);
      new google.translate.TranslateElement({ pageLanguage: 'en', autoDisplay: false }, 'google_translate_element');
    };
    if (document.readyState !== 'loading') start(); else document.addEventListener('DOMContentLoaded', start);
  };
  var sc = document.createElement('script'); sc.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit'; sc.async = true;
  document.head.appendChild(sc);
})();
</script>
<link rel="preconnect" href="https://translate.googleapis.com" crossorigin>
<%
  // Google settings from the admin panel (data/seo-settings.js): verification codes, Analytics, the share picture,
  // and a page's own "hide from Google" switch and share picture (16 Oct 2026)
  const G = seoSettings || {};
  const pdx = typeof d !== 'undefined' && d ? d : {};
  const robotsTag = pdx.noindex || pdx.nofollow ? (pdx.noindex ? 'noindex' : 'index') + ', ' + (pdx.nofollow ? 'nofollow' : 'follow') : (typeof meta !== 'undefined' && meta && meta.robots);
  // (28 Oct 2026) a page's own canonical address, set in its SEO panel, wins over the built-in one
  if (pdx.canonical && typeof meta !== 'undefined' && meta) meta = Object.assign({}, meta, { canonical: pdx.canonical });
%>
<title><%= title %></title>
<% if (typeof meta !== 'undefined' && meta) { %>
<% if (meta.description) { %><meta name="description" content="<%= meta.description %>"><% } %>
<% if (meta.keywords) { %><meta name="keywords" content="<%= meta.keywords %>"><% } %>
<% if (meta.canonical) { %><link rel="canonical" href="<%= /^https?:/.test(meta.canonical) ? meta.canonical : base + meta.canonical %>"><% } %>
<% } %>
<% if (robotsTag) { %><meta name="robots" content="<%= robotsTag %>"><% } %>
<% if (G.googleVerification) { %><meta name="google-site-verification" content="<%= G.googleVerification %>"><% } %>
<% if (G.bingVerification) { %><meta name="msvalidate.01" content="<%= G.bingVerification %>"><% } %>
<% if (/^G-[A-Z0-9]{4,}$/i.test(G.googleAnalytics || '')) { %>
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= G.googleAnalytics %>"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',<%- JSON.stringify(G.googleAnalytics) %>);</script>
<% } %>
<%
  // Open Graph / Twitter cards and schema.org JSON-LD (SEO, AI answers and generative search)
  const mt = (typeof meta !== 'undefined' && meta) || {};
  const pd = pdx;
  const shareSrc = [pd.ogImage, mt.ogImage, pd.photo, pd.heroSrc, G.defaultShareImage, '/photos/taj-mahal-feature.webp'].find(x => x && /^\//.test(x));
  const ogImg = base + shareSrc;
  const pg = {};
  if (Array.isArray(pd.faqs) && pd.faqs[0] && pd.faqs[0].q) pg.faqs = pd.faqs;
  if (pd.route && pd.days) pg.trip = pd;
  if (Array.isArray(pd.breadcrumb)) pg.breadcrumb = pd.breadcrumb;
%>
<meta name="theme-color" content="#336699">
<meta property="og:type" content="<%= pg.trip ? 'article' : 'website' %>">
<meta property="og:site_name" content="<%= seo.NAME %>">
<%
  // (28 Oct 2026) social media text and pictures from the page's SEO panel; empty ones fall back to the Google text
  const ogT = pd.ogTitle || mt.ogTitle || title, ogD = pd.ogDescription || mt.ogDescription || mt.description;
  const twT = pd.twTitle || mt.twTitle || ogT, twD = pd.twDescription || mt.twDescription || ogD;
  const twSrc = [pd.twImage, mt.twImage].find(x => x && /^\//.test(x)), twImg = twSrc ? base + twSrc : ogImg;
%>
<meta property="og:title" content="<%= ogT %>">
<% if (ogD) { %><meta property="og:description" content="<%= ogD %>"><% } %>
<% if (mt.canonical) { %><meta property="og:url" content="<%= /^https?:/.test(mt.canonical) ? mt.canonical : base + mt.canonical %>"><% } %>
<meta property="og:image" content="<%= ogImg %>">
<meta property="og:locale" content="en_GB">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= twT %>">
<% if (twD) { %><meta name="twitter:description" content="<%= twD %>"><% } %>
<meta name="twitter:image" content="<%= twImg %>">
<script type="application/ld+json"><%- JSON.stringify(seo.graph(base, pg)).replace(/</g, '\\u003c') %></script>
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&amp;family=Instrument+Serif:ital@0;1&amp;family=Manrope:wght@400;500;600;700;800&amp;family=Shantell+Sans:wght@400;500&amp;display=swap" rel="stylesheet">
<link rel="stylesheet" href="<%= typeof cssHref !== 'undefined' ? cssHref : '/css/site.css' %>">
<% if (typeof extraCss !== 'undefined') { [].concat(extraCss).forEach(h => { %><link rel="stylesheet" href="<%= h %>"><% }) } %>
<script src="<%= typeof siteJs !== 'undefined' ? siteJs : '/js/site.js?v=3' %>" defer></script>
<% if (typeof frameClass !== 'undefined' && frameClass.split(' ').includes('in4')) { %><script src="/js/inner-4.js" defer></script><% } %>
</head>
<body>
