<%
  // The one footer for every page. Links come from the home data (app.locals.footer);
  // on-page anchors like "#plan" are made absolute so they work from any page.
  const F = footer;
  const abs = h => (h && h[0] === '#') ? '/' + h : h;
  // an item is [label, link] (23 Oct 2026: main pages only); a plain label is still looked up as before
  const fLabel = i => Array.isArray(i) ? i[0] : i;
  const fHref = (i, col) => Array.isArray(i) ? i[1] : i === 'Guest reviews' ? F.testimonialsHref : abs(menu.to(i, col === 'Travel guide' ? 'guide' : ''));
  // Company column also carries any original footer link not already in the footer (e.g. Important Links)
  const shown = new Set(F.cols.flatMap(c => c.items.map(i => fHref(i, c.title))));
  const extra = (F.legacy || []).filter(l => !shown.has(l.href));
  const tel = p => 'tel:' + p.replace(/[^0-9+]/g, '');
  // (23 Oct 2026, client doc) headings and links in Upper and Lower Case: "Tour Packages", "Travel Guide"
  const tc = s => String(s).replace(/(^|[\s(])([a-z])/g, (m, a, b) => a + b.toUpperCase()).replace(/(\s)(And|Of|The|To|In|For)(?=\s)/g, (m, a, w) => a + w.toLowerCase());
  const SV = d => '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">' + d + '</svg>';
  const SOC = {
    Facebook: SV('<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H8v4h2v8h4v-8h3l1-4h-4V8z"/>'),
    Instagram: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>',
    YouTube: SV('<path d="M21.6 7.2a2.6 2.6 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.6 2.6 0 0 0 2.4 7.2 27 27 0 0 0 2 12a27 27 0 0 0 .4 4.8 2.6 2.6 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.6 2.6 0 0 0 1.8-1.8A27 27 0 0 0 22 12a27 27 0 0 0-.4-4.8zM10 15V9l5.2 3L10 15z"/>'),
    X: SV('<path d="M17.8 3h3.1l-6.8 7.8L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.3-8.3L2 3h6.4l4.4 5.8L17.8 3zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5z"/>'),
    LinkedIn: SV('<path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3V9.5zm7 0h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.2c0-1.2 0-2.9-1.8-2.9s-2 1.4-2 2.8V21h-4V9.5z"/>')
  };
%>
<footer class="sf">
  <%# (21 Oct 2026, client) the "Enjoy Your Trip" band is removed from the footer %>
  <div class="sf-wrap sf-main">
    <div class="sf-brand">
      <a href="/" class="sf-logo" aria-label="Meruka India Tourism — home">
        <% if (F.logo) { %><img src="<%= F.logo %>" alt="Meruka India Tourism Service" style="height:48px;width:auto;display:block"><% } else { %>
        <span class="mlogo sf-logo-mark" aria-hidden="true"></span>
        <span class="sf-logo-name notranslate" translate="no">MERUKA INDIA TOURISM SERVICE</span><% } %>
      </a>
      <p class="sf-about"><%= F.about || 'Inbound travel agency for overseas visitors. Private tours, 3–5 star hotels, a dedicated car and driver from arrival to departure.' %></p>
      <% const S = F.social || []; if (S.length) { %>
      <div class="sf-social"><span class="sf-seo-t">Follow us</span>
        <% S.forEach(x => { const ic = SOC[x.name] || ''; %>
        <% if (x.href) { %><a href="<%= x.href %>" target="_blank" rel="noopener" class="sf-soc" aria-label="<%= x.name %>"><%- ic %></a><% } else { %><span class="sf-soc sf-soc-off" title="<%= x.name %> — link to be added" aria-label="<%= x.name %>"><%- ic %></span><% } %>
        <% }) %>
      </div>
      <% } %>
    </div>
    <% F.cols.forEach(c => { %>
    <nav class="sf-col" aria-label="<%= tc(c.title) %>">
      <span class="sf-col-t"><%= tc(c.title) %></span>
      <% c.items.forEach(i => { %><a href="<%= fHref(i, c.title) %>"><%= tc(fLabel(i)) %></a><% }) %>
    </nav>
    <% }) %>
  </div>

  <div class="sf-wrap sf-seo">
    <span class="sf-seo-t">Popular searches</span>
    <div class="sf-seo-list"><% F.seo.forEach(s => { const lbl = Array.isArray(s) ? s[0] : s, h = Array.isArray(s) ? s[1] : menu.to(s); if (!lbl) return; %><a href="<%= abs(h) %>"><%= lbl %></a><% }) %></div>
  </div>

  <div class="sf-bottom-band">
    <div class="sf-wrap sf-bottom">
      <div class="sf-bottom-l">
        <span>© <%= new Date().getFullYear() %> Meruka India Tourism Service</span>
      </div>
      <div class="sf-bottom-r">
        <a href="#top" class="sf-top" aria-label="Back to top">Back to top <span>↑</span></a>
      </div>
    </div>
  </div>
</footer>
<a href="<%= F.wa %>" target="_blank" rel="noopener" class="wa-float" aria-label="Chat with us on WhatsApp">
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>
  <span>WhatsApp us</span>
</a>
<%# (27 Oct 2026, client video "Site-responsive") on phones the site works like an app: a bar along the bottom with the main places %>
<% const mbI = d => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + d + '</svg>'; %>
<nav class="mb-nav" aria-label="Quick links">
  <a href="/" data-mb="/"><%- mbI('<path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>') %><span>Home</span></a>
  <a href="/itineraries" data-mb="/itineraries"><%- mbI('<path d="M4 18 9 6l4 8 3-5 4 9z"/>') %><span>Tours</span></a>
  <a href="/plan-my-trip" class="mb-go" data-mb="/plan-my-trip"><%- mbI('<path d="M12 5v14M5 12h14"/>') %><span>Plan Trip</span></a>
  <a href="/guide" data-mb="/guide"><%- mbI('<path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 19V5"/>') %><span>Guide</span></a>
  <a href="<%= F.wa %>" target="_blank" rel="noopener" class="mb-wa"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg><span>WhatsApp</span></a>
</nav>
<script>(function(){var p=location.pathname.replace(/\/+$/,'')||'/';document.querySelectorAll('.mb-nav [data-mb]').forEach(function(a){if(a.getAttribute('data-mb')===p)a.setAttribute('aria-current','page');});})();</script>
