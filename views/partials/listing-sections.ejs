<%
  const h2 = "font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(32px,4cqw,56px);font-weight:600;line-height:1;margin:0;letter-spacing:-.04em";
  const em = "font-family:'Instrument Serif',Georgia,serif;font-style:italic;font-weight:400;letter-spacing:-.01em";
  const ext = h => /^https?:/.test(h) ? ' target="_blank" rel="noopener"' : '';
%>
<section id="tourist-destinations" class="ls">
  <div class="az-wrap">
    <div class="az-head h4-head">
      <div><h2 class="h4-h2">Tourist Destinations <em>of India</em></h2></div>
    </div>
    <div class="a-regions">
      <% L.regions.forEach(r => { %>
      <a class="ls-card" href="<%= r.href %>"<%- ext(r.href) %> style="position:relative;display:block;height:clamp(240px,26cqw,340px);border-radius:26px;overflow:hidden;background:#123F6D;color:#fff" data-hover="color:#fff">
        <img class="ls-img" src="<%= r.img %>" alt="<%= r.name %>" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">
        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(7,20,42,.92) 0%,rgba(7,20,42,.3) 50%,rgba(7,20,42,0) 80%)"></div>
        <div style="position:absolute;left:20px;right:20px;bottom:20px;display:flex;align-items:flex-end;justify-content:space-between;gap:12px">
          <div style="font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(22px,2.2cqw,30px);font-weight:600;letter-spacing:-.03em;line-height:1"><%= r.name %></div>
          <span class="ls-go" style="flex-shrink:0;width:36px;height:36px;border-radius:5px;background:#FFB81C;color:#141B2B;display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:800">↗</span>
        </div>
      </a>
      <% }) %>
    </div>
  </div>
</section>
