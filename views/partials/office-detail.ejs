<%
  const pad = n => (n < 10 ? '0' : '') + n;
  const addrText = o.lines.join(' ').replace(/,\s*$/, '');
  const cpB = 'height:44px;padding:0 14px;border-radius:12px;border:1px solid #E2E8F0;background:#F7F9FC;color:#33445E;font-weight:700;font-size:13.5px;cursor:pointer;white-space:nowrap;transition:all .2s';
  const cpD = cpB + ';background:#E8F6EE;border-color:#BFE6CF;color:#1F8A55';
  const adB = cpB + ';height:40px;font-size:13px;background:#fff';
  const adD = adB + ';background:#E8F6EE;border-color:#BFE6CF;color:#1F8A55';
  const badge = oi === 0
    ? 'font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#336699;background:#FFB81C;padding:5px 11px;border-radius:99px'
    : 'font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#336699;background:#E3EDFE;padding:5px 11px;border-radius:99px';
  const rows = o.phones.map((p, j) => ({ label: o.phones.length > 1 ? 'Mobile ' + (j + 1) : 'Phone', value: p, raw: p.replace(/[^0-9+]/g, ''), href: 'tel:' + p.replace(/[^0-9+]/g, ''), cta: 'Call', mail: false }))
    .concat([{ label: 'Email', value: o.email, raw: o.email, href: 'mailto:' + o.email, cta: 'Email', mail: true }]);
  const iconStyle = mail => 'width:44px;height:44px;border-radius:13px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:' + (mail ? '#E3EDFE' : '#FFF4DC') + ';color:' + (mail ? '#336699' : '#B7791F');
%>
<div class="off-detail<%= oi === 0 ? '' : ' is-hidden' %>" data-office="<%= oi %>" style="position:relative;overflow:hidden;background:#fff;border-radius:26px;padding:clamp(20px,3cqw,34px);display:flex;flex-direction:column;gap:20px;min-width:0;<%= inline ? 'margin:6px 0 14px;' : 'height:100%;' %>animation:mkup .45s ease both">
  <div style="position:absolute;right:-.04em;top:-.2em;font-family:'Instrument Serif',Georgia,serif;font-style:italic;font-size:clamp(110px,14cqw,210px);line-height:1;color:#F0F4FA;pointer-events:none;user-select:none;letter-spacing:-.03em"><%= pad(oi + 1) %></div>
  <div style="position:relative;display:flex;align-items:center;gap:8px;flex-wrap:wrap">
    <span style="<%= badge %>"><%= o.kind %></span>
    <span style="font-size:13px;font-weight:600;color:#8A97AB"><%= pad(oi + 1) %> / <%= pad(total) %></span>
  </div>
  <div style="position:relative">
    <div style="font-family:'Instrument Serif',Georgia,serif;font-style:italic;font-size:clamp(50px,5.6cqw,84px);line-height:.9;letter-spacing:-.03em;color:#336699;margin-bottom:12px"><%= o.city %><span style="color:#FFB81C">.</span></div>
    <div style="font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(18px,1.7cqw,22px);font-weight:600;letter-spacing:-.02em;color:#0B1B33"><%= o.name %></div>
    <% if (o.sub) { %><div style="font-size:13.5px;color:#8A97AB;margin-top:3px"><%= o.sub %></div><% } %>
  </div>
  <div style="position:relative;display:flex;gap:14px;align-items:flex-start;background:#F7F9FC;border:1px solid #EEF2F7;border-radius:18px;padding:16px 18px">
    <span style="width:40px;height:40px;border-radius:12px;background:#FFF4DC;color:#B7791F;display:flex;align-items:center;justify-content:center;flex-shrink:0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg></span>
    <div style="flex:1;min-width:0">
      <% o.lines.forEach(l => { %><div style="font-size:15px;line-height:1.6;color:#33445E"><%= l %></div><% }) %>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px">
        <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(addrText) %>" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;height:40px;padding:0 14px;border-radius:11px;background:#336699;color:#fff;font-weight:700;font-size:13.5px" data-hover="background:#336699;color:#fff">Open in Maps ↗</a>
        <button class="copy" data-copy="<%= addrText %>" data-label="Copy address" data-on="<%= adD %>" data-off="<%= adB %>" style="<%= adB %>">Copy address</button>
      </div>
    </div>
  </div>
  <div style="position:relative;display:flex;flex-direction:column">
    <% rows.forEach(r => { %>
    <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:14px 0;border-top:1px solid #EEF2F7">
      <span style="<%= iconStyle(r.mail) %>">
        <% if (r.mail) { %><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
        <% } else { %><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg><% } %>
      </span>
      <a href="<%= r.href %>" style="flex:1 1 170px;min-width:0;display:block;color:#0B1B33" data-hover="color:#336699">
        <span style="display:block;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#8A97AB;margin-bottom:2px"><%= r.label %></span>
        <span style="display:block;font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(17px,1.5cqw,20px);font-weight:600;letter-spacing:-.01em;overflow-wrap:anywhere"><%= r.value %></span>
      </a>
      <span style="display:flex;gap:6px;flex-shrink:0">
        <button class="copy" data-copy="<%= r.raw %>" data-label="Copy" aria-label="Copy <%= r.value %>" data-on="<%= cpD %>" data-off="<%= cpB %>" style="<%= cpB %>">Copy</button>
        <a href="<%= r.href %>" style="display:inline-flex;align-items:center;justify-content:center;min-width:74px;height:44px;padding:0 16px;border-radius:12px;background:#FFB81C;color:#336699;font-weight:800;font-size:14px" data-hover="background:#336699;color:#fff"><%= r.cta %></a>
      </span>
    </div>
    <% }) %>
  </div>
</div>
