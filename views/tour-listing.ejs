<%- include('partials/head') %>
<%
  const pad = n => (n < 10 ? '0' : '') + n;
  const enquire = '/contactus#enquiry';
  const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const paraHtml = segs => segs.map(s => s.bold ? '<strong>' + esc(s.text) + '</strong>' : esc(s.text)).join('');
  const slug = s => s.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const titled = d.groups.filter(g => g.title);
  const showChips = titled.length > 3;
  const tourCount = d.groups.reduce((n, g) => n + g.tours.length, 0);
  const heroImg = photoFor([d.heading, d.url]);
  // Hero stats, all counted from this page's tours: how many, the nights range, how many places, how many categories
  const allTours = d.groups.flatMap(g => g.tours);
  const nights = allTours.map(t => +((String(t.duration || '').match(/(\d+)\s*Nights?/i) || [])[1] || 0)).filter(Boolean);
  const placeSet = new Set(); allTours.forEach(t => String(t.route || '').split(/\s+[-–]\s+/).map(x => x.trim()).filter(x => x && !/home\s*town/i.test(x)).forEach(x => placeSet.add(x.toLowerCase())));
  const ico = p => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + p + '</svg>';
  const stat = (icon, num, label) => '<div class="ph-stat"><span class="ph-stat-i">' + ico(icon) + '</span><span><b>' + num + '</b><small>' + label + '</small></span></div>';
  const stats = [stat('<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>', tourCount, tourCount === 1 ? 'Tour' : 'Tours')];
  if (nights.length) stats.push(stat('<path d="M20 14A8 8 0 1 1 10 4a6.5 6.5 0 0 0 10 10z"/>', Math.min(...nights) === Math.max(...nights) ? Math.min(...nights) : Math.min(...nights) + '–' + Math.max(...nights), 'Nights'));
  if (placeSet.size) stats.push(stat('<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>', placeSet.size, 'Places'));
  if (titled.length > 1) stats.push(stat('<path d="M4 6h16M4 12h16M4 18h10"/>', titled.length, 'Categories'));
  const facts = '<div class="ph-stats">' + stats.join('') + '</div>'
    + '<div class="ph-actions"><a href="#tour-options" class="ph-btn ph-btn-gold">Browse tours <span>↓</span></a><a href="' + enquire + '" class="ph-btn ph-btn-line">Enquire now <span>→</span></a></div>';
  let n = 0;
%>
<div style="width:100%;overflow-x:clip;background:#F4F7FB">
<div id="mk-frame" class="<%= typeof frameClass !== 'undefined' ? frameClass : '' %>" style="container-type:inline-size;width:100%;background:#F4F7FB">

<%- include('partials/page-header', { nav: d.nav, enquireHref: enquire }) %>

<%- include('partials/photo-hero', { title: d.heading, img: d.heroSrc, alt: d.heroAlt || '', crumbs: d.breadcrumb }) %>

<% // Filters: only the options this page's tours actually have
   const ROWS = G.flatMap(g => g.rows);
   const inRange = (v, r) => { const [a, b] = r.split('-').map(Number); return v && v >= a && v <= b; };
   const PRICES = [['', 'Any price'], ['0-999', 'Under USD 1,000'], ['1000-1999', 'USD 1,000 – 2,000'], ['2000-2999', 'USD 2,000 – 3,000'], ['3000-99999', 'USD 3,000 and above']]
     .filter(([r], i) => !i || ROWS.some(t => inRange(t.price, r)));
   const DAYS = [['', 'Any length'], ['0-7', 'Up to 7 nights'], ['8-10', '8 – 10 nights'], ['11-14', '11 – 14 nights'], ['15-20', '15 – 20 nights'], ['21-99', '21 nights +']]
     .filter(([r], i) => !i || ROWS.some(t => inRange(t.nights, r)));
   const REGIONS = [['north', 'North India'], ['south', 'South India'], ['east', 'East India'], ['west', 'West India']].filter(([k]) => ROWS.some(t => t.regions.includes(k)));
   const INTERESTS = ['Heritage', 'Wildlife', 'Religious', 'Beaches', 'Wellness', 'Festivals', 'Adventure', 'Villages'].filter(k => ROWS.some(t => t.interests.includes(k)));
   const usd = v => 'USD ' + Number(v).toLocaleString('en-US');
   const nightsTxt = g => g.nights ? (g.nights[0] === g.nights[1] ? g.nights[0] : g.nights[0] + '–' + g.nights[1]) + ' nights' : '';
%>
<!-- Tour packages: each category a card (photo, title, line, lowest price); open it for its tours.
     Filters on the right: price, region, interest, length. -->
<section id="tour-options" class="tp2">
  <div class="tp2-wrap">
    <div class="tp2-grid">
      <div class="tp2-list">
        <h2 class="h4-h2 tp2-heading">Best Tour Packages <em>in The Industry</em></h2>
        <p class="tp2-status is-hidden" data-tp2-count data-total="<%= ROWS.length %>"></p>
        <div class="tp2-none is-hidden" data-tp2-none>No tours match these filters. <button type="button" data-tp2-clear>Clear filters</button></div>
        <% G.forEach((g, gi) => { const open = gi === 0; %>
        <article class="tp2-card<%= open ? ' open' : '' %>" data-tp2-group id="<%= slug(g.title) %>">
          <div class="tp2-top" data-tp2-toggle>
            <span class="tp2-img"><img src="<%= g.img %>" alt="" loading="<%= gi < 3 ? 'eager' : 'lazy' %>"></span>
            <span class="tp2-info">
              <h3 class="tp2-title"><%= g.title %></h3>
              <% if (g.desc || g.line) { %><span class="tp2-line"><%= g.desc || g.line %></span><% } %>
            </span>
            <span class="tp2-price">
              <small>Starts From</small>
              <b><%= g.from ? usd(g.from) : 'On request' %></b><% if (g.from) { %><em>per person</em><% } %>
              <button type="button" class="tp2-chev" aria-expanded="<%= open %>" aria-controls="tp2-rows-<%= gi %>" aria-label="Show the tours in <%= g.title %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
            </span>
          </div>
          <div class="tp2-rows" id="tp2-rows-<%= gi %>">
            <% g.rows.forEach(t => { %>
            <div class="tp2-row" data-tp2-row data-price="<%= t.price || '' %>" data-nights="<%= t.nights || '' %>" data-region="<%= t.regions.join(' ') %>" data-interest="<%= t.interests.join(' ') %>" data-search="<%= (t.name + ' ' + t.route + ' ' + g.title).toLowerCase() %>">
              <div class="tp2-row-main">
                <% if (t.href) { %><a class="tp2-row-name" href="<%= t.href %>"><%= t.name %></a><% } else { %><span class="tp2-row-name"><%= t.name %></span><% } %>
                <% if (t.route) { %><span class="tp2-row-route"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg><span><%= t.route %></span></span><% } %>
              </div>
              <% if (t.duration) { %><span class="tp2-row-days"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14A8 8 0 1 1 10 4a6.5 6.5 0 0 0 10 10z"/></svg><%= t.duration.replace(/\s*[-–]\s*/, ' / ') %></span><% } %>
              <span class="tp2-row-price"><% if (t.price) { %><small>From</small><%= usd(t.price) %><em>per person</em><% } else { %><small>Price</small>On request<% } %></span>
              <% if (t.href) { %><a class="tp2-row-go" href="<%= t.href %>">View Tour <span>→</span></a><% } %>
            </div>
            <% }) %>
            <% if (g.href && g.href !== d.url) { %><a class="tp2-all" href="<%= g.href %>">All <%= g.title %> <span>→</span></a><% } %>
          </div>
        </article>
        <% }) %>
      </div>

      <aside class="tp2-side">
        <details class="tp2-filters" data-tp2-details open>
          <summary class="tp2-f-sum">Filters <span data-tp2-fcount></span></summary>
          <form class="tp2-form" data-tp2-form onsubmit="return false">
            <div class="tp2-f-head"><span class="tp2-f-title">Filters</span><button type="button" class="tp2-reset" data-tp2-clear>Reset</button></div>
            <label class="tm-search tp2-q"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><span class="sr-only">Search tours</span><input type="search" name="q" placeholder="Search a tour or place" autocomplete="off"></label>
            <% if (PRICES.length > 2) { %>
            <fieldset class="tp2-fs"><legend>Price</legend>
              <div class="tp2-chips"><% PRICES.forEach(([v, l], i) => { %><label class="tp2-chip"><input type="radio" name="price" value="<%= v %>"<%= i ? '' : ' checked' %>><span><%= l %></span></label><% }) %></div>
            </fieldset>
            <% } %>
            <% if (REGIONS.length > 1) { %>
            <fieldset class="tp2-fs"><legend>Region</legend>
              <div class="tp2-chips"><% REGIONS.forEach(([v, l]) => { %><label class="tp2-chip"><input type="checkbox" name="region" value="<%= v %>"><span><%= l %></span></label><% }) %></div>
            </fieldset>
            <% } %>
            <% if (INTERESTS.length > 1) { %>
            <fieldset class="tp2-fs"><legend>Interest</legend>
              <div class="tp2-chips"><% INTERESTS.forEach(v => { %><label class="tp2-chip"><input type="checkbox" name="interest" value="<%= v %>"><span><%= v %></span></label><% }) %></div>
            </fieldset>
            <% } %>
            <% if (DAYS.length > 2) { %>
            <fieldset class="tp2-fs"><legend>Length</legend>
              <div class="tp2-chips"><% DAYS.forEach(([v, l], i) => { %><label class="tp2-chip"><input type="radio" name="nights" value="<%= v %>"<%= i ? '' : ' checked' %>><span><%= l %></span></label><% }) %></div>
            </fieldset>
            <% } %>
          </form>
          <div class="tp2-enq">
            <p>Can't find the right tour? We'll plan one around you.</p>
            <a href="<%= enquire %>" class="ph-btn ph-btn-gold">Enquire Now <span>→</span></a>
          </div>
        </details>
      </aside>
    </div>

    <% if (d.outro.length) { %>
    <div class="tl2-outro tp2-outro">
      <% d.outro.forEach(p => { %><p><%- paraHtml(p) %></p><% }) %>
    </div>
    <% } %>
  </div>
</section>

<%- include('partials/popular-tours', { current: d.url }) %>

<%- include('partials/page-footer', { footCols: d.footCols, enquireHref: enquire }) %>

</div>
</div>
<script src="/js/tour-listing.js" defer></script>
</body>
</html>
