<%- include('partials/head') %>
<%
  // Plan My Trip (15 Oct 2026, redesigned): a clean two-column page inside the site container — the enquiry form in a
  // white card on the left (labelled fields), what happens next and the direct ways to reach a planner on the right.
  // The form keeps the home page form's ids and field names, so public/js/home-2.js sends it the same way.
  // ?tour=<name> (from a tour page) fills in the message.
  const enquire = '/plan-my-trip';
  const tel = 'tel:' + footer.hq.phones[0].replace(/[^0-9+]/g, '');
  const ico = p => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + p + '</svg>';
  const tourName = q.tour ? String(q.tour).slice(0, 120) : '';
  const tourPick = tourName ? tourCodeOptions.find(t => t.name.toLowerCase() === tourName.toLowerCase()) : null;
  const prefill = tourName ? (tourPick ? 'Tour Code: ' + tourPick.code + ' (' + tourPick.name + ') — ' : '') + 'I would like to know more about the ' + tourName + '.' : '';
  // hotel chips: the chosen one is drawn with data-on (set again by the script on click)
  const chipOff = 'border:1.5px solid var(--mk-line);background:#fff;color:var(--mk-text)';
  const chipOn = 'border:1.5px solid var(--mk-blue);background:var(--mk-blue);color:#fff';
%>
<div style="width:100%;overflow-x:clip;background:#fff">
<div id="mk-frame" class="<%= typeof frameClass !== 'undefined' ? frameClass : '' %>" style="container-type:inline-size;width:100%;background:#fff">

<%- include('partials/page-header', { nav: d.nav, enquireHref: enquire }) %>

<%- include('partials/photo-hero', { title: 'Plan My Trip', img: '/photos/hero-ladakh.webp', alt: 'A mountain lake below brown Himalayan peaks', sub: 'Tell us how you would like to travel — a planner replies within one working day, with a route and a price.' }) %>

<section class="pm" aria-label="Plan your trip">
  <div class="ex-wrap pm-grid">

    <!-- the enquiry form -->
    <div class="pm-card">
      <div class="pm-card-head">
        <h2 class="pm-card-t">Your trip details</h2>
        <ul class="pm-trust"><li>Reply in 24h</li><li>No obligation</li><li>No deposit</li><li>Details never shared</li></ul>
      </div>

      <div id="plan-sent" class="is-hidden pm-sent">
        <span class="pm-sent-tick" aria-hidden="true">✓</span>
        <p class="pm-sent-t">Enquiry received</p>
        <p class="pm-sent-p">A planner will write within one working day. Urgent? Call <a href="<%= tel %>"><%= footer.hq.phones[0] %></a>.</p>
      </div>

      <form id="plan-form" class="pm-body" novalidate>
        <%# (23 Oct 2026, client) the fields and choices of the original site's form (helpmetours.aspx), from
            data/enquiry-options.js. (23 Oct 2026, client) only what a planner needs is required (*): name, email, country and the message %>
        <% const O = enquiryOptions, opt = (list, first) => (first ? '<option value="">' + first + '</option>' : '') + list.map(v => '<option value="' + v.replace(/"/g, '&quot;') + '">' + v.replace(/</g, '&lt;') + '</option>').join(''); %>
        <div class="pm-fields">
          <label class="pm-f pm-f-name"><span>Name <i aria-hidden="true">*</i></span>
            <span class="pm-pair pm-pair-title"><select name="title" class="pm-in" aria-label="Title"><%- opt(O.titles) %></select><input name="name" class="pm-in" placeholder="Your full name" autocomplete="name" required></span></label>
          <label class="pm-f"><span>Email Id <i aria-hidden="true">*</i></span><input name="email" type="email" class="pm-in" placeholder="name@example.com" autocomplete="email" required></label>
          <label class="pm-f"><span>Country <i aria-hidden="true">*</i></span><select name="country" class="pm-in" required><%- opt(O.countries, 'Select Country') %></select></label>
          <div class="pm-f"><span>Travel Period</span>
            <span class="pm-pair"><select name="travelMonth" class="pm-in" aria-label="Month"><%- opt(O.months, 'Month') %></select><select name="travelYear" class="pm-in" aria-label="Year"><%- opt(O.years, 'Year') %></select></span></div>
          <label class="pm-f"><span>No. of Days for the Trip</span><select name="days" class="pm-in"><%- opt(O.days, 'Select') %></select></label>
          <div class="pm-f"><span>No. of People Traveling</span>
            <span class="pm-pair"><select name="adults" class="pm-in" aria-label="Adults"><%- opt(O.adults, 'Adults') %></select><select name="children" class="pm-in" aria-label="Children (over 5 years)"><%- opt(O.children, 'Children (over 5 years)') %></select></span></div>
          <label class="pm-f"><span>Hotel Budget (per day in USD)</span><select name="hotelBudget" class="pm-in"><%- opt(O.hotelBudget, 'Select') %></select></label>
          <label class="pm-f"><span>Hotel Category</span><select name="hotelCategory" class="pm-in"><%- opt(O.hotelCategory, 'Select') %></select></label>
        </div>

        <%# (23 Oct 2026, client) the tour code is written in the message itself (no separate box); from a tour page the
            message starts with that tour's code and name %>
        <label class="pm-f pm-msg"><span>Preferred Destinations / Required Services / Tour Code <i aria-hidden="true">*</i></span><textarea name="message" rows="5" class="pm-in" placeholder="The places you'd like to see, the services you need and a tour code if you have one — e.g. GT-1 plus the Kerala backwaters, a guide in Jaipur." required><%= prefill %></textarea>
          <small class="pm-hint">Each tour page shows its code under the title.</small></label>

        <%# (23 Oct 2026, client) a security code as on the old site's form (picture from /api/captcha, checked by the server) %>
        <div class="pm-f pm-cap" data-captcha><span id="pm-cap-h">Security Code <i aria-hidden="true">*</i></span>
          <span class="pm-cap-row">
            <span class="pm-cap-img" data-captcha-img aria-live="polite"></span>
            <button type="button" class="pm-cap-new" data-captcha-new aria-label="Show a new code" title="Show a new code"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7"/></svg></button>
            <input name="captcha" class="pm-in pm-cap-in" aria-labelledby="pm-cap-h" placeholder="Type the code" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="5" required>
            <input type="hidden" name="captchaToken" data-captcha-token>
          </span>
        </div>

        <p class="pm-req"><i aria-hidden="true">*</i> Please Fill Mandatory Field.</p>
        <div id="plan-err" class="is-hidden pm-err" role="alert"></div>
        <button type="submit" class="pv-submit pm-go">Send My Enquiry</button>
        <p class="pm-note">By sending this you agree that a Meruka planner may contact you about your trip.</p>
      </form>
    </div>

    <!-- what happens next, and the direct ways to reach a planner -->
    <aside class="pm-side">
      <div class="pm-box">
        <p class="pm-box-t">What happens next</p>
        <ol class="pm-steps">
          <li><span class="pm-n">1</span><div><b>Tell us your plan</b><small>A few lines are enough.</small></div></li>
          <li><span class="pm-n">2</span><div><b>Get your itinerary and price</b><small>Within one working day — change it as often as you like.</small></div></li>
          <li><span class="pm-n">3</span><div><b>Travel with your own car and driver</b><small>Hotels you chose, our team on call across India.</small></div></li>
        </ol>
      </div>
      <div class="pm-reach">
        <p class="pm-reach-t">Rather talk to a planner?</p>
        <a href="<%= tel %>" class="pm-line"><span class="pm-ic"><%- ico('<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>') %></span><span><small>Call us</small><b><%= footer.hq.phones[0] %></b></span></a>
        <a href="<%= footer.wa %>" target="_blank" rel="noopener" class="pm-line"><span class="pm-ic"><%- ico('<path d="M3 21l1.7-5A8.5 8.5 0 1 1 8 19.3z"/>') %></span><span><small>WhatsApp</small><b>Chat with a planner</b></span></a>
        <a href="mailto:<%= footer.hq.email %>" class="pm-line"><span class="pm-ic"><%- ico('<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>') %></span><span><small>Email</small><b><%= footer.hq.email %></b></span></a>
      </div>
    </aside>

  </div>
</section>

<%- include('partials/explore-india', { current: '/plan-my-trip', skipRegions: true, skipGuide: true }) %>

<%- include('partials/page-footer', { footCols: d.footCols, enquireHref: enquire }) %>

</div>
</div>
<script src="/js/home-2.js" defer></script>
</body>
</html>
