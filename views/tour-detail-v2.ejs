<%- include('partials/head') %>
<%
  const words = d.heading.split(' ');
  const lastWord = words.pop();
  const routeParts = d.route.split(/\s+([-–])\s+/);   // keep whichever separator the original used
  const stops = routeParts.filter((x, i) => i % 2 === 0), seps = routeParts.filter((x, i) => i % 2 === 1);
  // Renders [{ text, bold }] segments; bold parts use `b` as their style.
  const rs = (segs, b) => segs.map(s => s.bold ? '<strong style="' + b + '">' + escapeFn(s.text) + '</strong>' : escapeFn(s.text)).join('');
  const escapeFn = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const h3 = "font-family:'Bricolage Grotesque',sans-serif;font-size:22px;font-weight:600;letter-spacing:-.02em;margin:0 0 14px;color:#0B1B33";
  const pricing = d.details.find(b => /pric|cost/i.test(b.title)) || { title: '', text: '', items: [] };
  // Price lines come in several shapes on the originals: "3-Star: $85 - $100 per person per day",
  // "3-Star Hotels: USD 90 - USD 100 per person per day.", "5-Star: Available on request",
  // "Superior Category: ...", and sometimes an unbolded label. The wording is always shown as-is.
  const tiers = pricing.items.map(it => {
    const whole = it.map(x => x.text).join('').trim();
    const boldLabel = (it.find(x => x.bold) || { text: '' }).text.trim();
    const label = boldLabel || (whole.match(/^[^:]+:/) || [''])[0];
    const rest = boldLabel ? it.filter(x => !x.bold).map(x => x.text).join('').trim() : whole.slice(label.length).trim();
    // also "USD 90-100", "US$90–100" and "$90–$100" (the itinerary documents of Oct 2026)
    const m = rest.match(/^((?:US\$\s*|\$\s*|USD\s*)(\d+)\s*[-–]\s*(?:US\$\s*|\$\s*|USD\s*)?(\d+)\s*\+?)\s*(.*)$/);
    const toUsd = s => String(s).replace(/US\$\s*/g, '$').replace(/(\$|USD)\s*([\d,]+)\s*[-–]\s*(?:\$|USD)?\s*([\d,]+)/g, 'USD $2 - $3').replace(/\$\s*/g, 'USD ');
    return { label, rest: toUsd(rest), range: toUsd(m ? m[1].trim() : rest), unit: m ? m[4] : '', priced: !!m, lo: m ? +m[2] : 0, hi: m ? +m[3] : 0, stars: parseInt(label, 10) || 0 };
  }).filter(t => t.label || t.rest);
  const priced = tiers.filter(t => t.priced);
  const tierMin = priced.length ? Math.min(...priced.map(t => t.lo)) : 0, tierMax = priced.length ? Math.max(...priced.map(t => t.hi)) : 0;
  const cur = 'USD ';
  tiers.forEach(t => {
    const span = Math.max(1, tierMax - tierMin);
    t.left = t.priced ? ((t.lo - tierMin) / span * 100).toFixed(1) : 0;
    t.width = t.priced ? Math.max(6, (t.hi - t.lo) / span * 100).toFixed(1) : 0;
  });
  // Enquiry link that also carries the chosen hotel category
  const withHotel = (href, hotel) => href.replace(/(#|$)/, m => (href.includes('?') ? '&' : '?') + 'hotel=' + encodeURIComponent(hotel) + m);
  const rest = d.details.filter(b => b !== pricing);
  const incl = rest.find(b => /includes/i.test(b.title));
  const excl = rest.find(b => /excludes/i.test(b.title));
  const notes = rest.filter(b => b !== incl && b !== excl);
  const pad = n => (n < 10 ? '0' : '') + n;
  const svg = p => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + p + '</svg>';
  const NOTE_ICONS = [
    { re: /closed|weather|schedule/i, warn: true, icon: svg('<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2"/><path d="M9 2h6"/>') },
    { re: /additional|upgrade|arranged/i, icon: svg('<path d="M12 3v18M3 12h18"/>') },
    { re: /price|cost|peak/i, icon: svg('<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>') },
    { re: /customi[sz]ed|modified|private/i, icon: svg('<path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/>') }
  ];
  const noteKind = segs => { const t = segs.map(x => x.text).join(''); return NOTE_ICONS.find(k => k.re.test(t)) || { icon: svg('<circle cx="12" cy="12" r="9"/><path d="M12 11v5"/>') }; };
  // Includes / excludes column look
  const tone = {
    in: { accent: '#1F8A55', soft: '#E8F6EE', ring: '#BFE6CF', icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>' },
    ex: { accent: '#C2412D', soft: '#FDEEEA', ring: '#F6CFC6', icon: '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>' }
  };
%>
<div style="width:100%;overflow-x:clip;background:#F4F7FB">
<div id="mk-frame" class="<%= typeof frameClass !== 'undefined' ? frameClass : '' %> td2" style="container-type:inline-size;width:100%;background:#F4F7FB">

<%- include('partials/page-header', { nav: d.nav, enquireHref: d.enquire.href }) %>

<%
  const heroImg = d.photo || photoFor([d.heading, d.url, d.route]);
  const jump = [['#itinerary', 'Itinerary', d.days.length]];
  if (pricing.title) jump.push(['#pricing', pricing.title]);
  if (d.hotels) jump.push(['#hotels', d.hotels.title]);
  if (incl) jump.push(['#inclusions', incl.title]);
  if (d.flights) jump.push(['#flights', d.flights.title]);
  if (excl) jump.push(['#excludes', excl.title]);
  notes.forEach((nb, i) => jump.push(['#note-' + i, nb.title]));
  // A photo for each day, as in the printed itineraries: the place the day is about, never the hero or a repeat
  const usedPh = new Set([heroImg]);
  // the place the day ends in comes first ("Tirupati – Varanasi" → Varanasi), then the others in the title
  const dayPhoto = day => {
    const places = String(day.title).replace(/^[^:]*\d(st|nd|rd|th)[^:]*:/i, '').split(/\s*[-–]\s*/).reverse();
    for (const pl of places) { const p = photoChoices(pl).find(x => !usedPh.has(x)); if (p) { usedPh.add(p); return p; } }
    // otherwise a sight named in bold in the day's text (Taj Mahal, Periyar…)
    for (const para of (day.paras || [])) for (const seg of para) {
      const t = String(seg.text || '').trim();
      if (!seg.bold || t.length < 4 || t.length > 50 || /airport|station|hotel|note/i.test(t)) continue;
      const p = photoChoices(t).find(x => !usedPh.has(x)); if (p) { usedPh.add(p); return p; }
    }
    return null;
  };
  // "Bangalore: Capital of Karnataka…" — a paragraph that opens with a bold place name is the place's background note (not shown)
  const isInfo = (para, k) => k > 0 && para[0] && para[0].bold && /:\s*$/.test(para[0].text);
  let photoSide = 0;
%>
<% const dhWords = d.heading.trim().split(' '); const dhLast = dhWords.length > 1 ? dhWords.pop() : '';
   const dhFrom = priced.length ? 'USD ' + tierMin : '';
   const dhUnit = priced.length ? (priced.find(t => t.lo === tierMin) || priced[0]).unit : '';
   const dhFixed = !priced.length && tiers.length === 1 ? (tiers[0].rest.match(/^(USD\s*[\d,]+)\s*(.*)$/) || null) : null; %>
<%
  // tour page v5: photos for the days first (the gallery uses the first two), then the page
  const dayPhotos = d.days.map(dayPhoto);
  const gallery = [heroImg].concat(dayPhotos.filter(Boolean).slice(0, 2));
  const hq = footer.hq, tel = 'tel:' + hq.phones[0].replace(/[^0-9+]/g, '');
  const ico = p => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + p + '</svg>';
  const I = {
    clock: ico('<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>'),
    cal: ico('<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>'),
    pin: ico('<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>'),
    flag: ico('<path d="M5 21V4M5 4h11l-2 4 2 4H5"/>'),
    end: ico('<circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/>'),
    phone: ico('<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>'),
    mail: ico('<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>')
  };
  const priceLine = dhFrom ? { pre: 'From', amt: dhFrom, unit: dhUnit } : dhFixed ? { pre: tiers[0].label.replace(/:$/, ''), amt: dhFixed[1].replace(/\s+/g, ' '), unit: dhFixed[2] } : null;
%>
<%
  // v2 (12 Oct 2026, this tour only): every fact once; package prices (per day × nights) so they match
  // the tour lists; the days in a zig-zag (photo right, then left); plain lists for includes / excludes / notes.
  const tdNights = +((String(d.duration).match(/(\d+)\s*Nights?/i) || [])[1] || 0);
  const tdUsd = v => 'USD ' + Number(v).toLocaleString('en-US');
  priced.forEach(t => {
    t.totalLo = t.lo * tdNights; t.totalHi = t.hi * tdNights; t.plus = /\+/.test(t.range);
    t.total = tdUsd(t.totalLo) + ' – ' + Number(t.totalHi).toLocaleString('en-US') + (t.plus ? '+' : '');
    t.perDay = tdUsd(t.lo) + ' – ' + t.hi + (t.plus ? '+' : '') + ' a day';
  });
  const tdFrom = priced.length && tdNights ? Math.min(...priced.map(t => t.totalLo)) : 0;
  const tdUnit = 'per person · ' + tdNights + ' nights';
  const tdDays = d.days.length;
  // the short description under the title: written by hand for some tours, otherwise built from the route
  const TD_DESC = {
    '/rajasthan_holiday_tour_packages': 'A private 11-day journey from Delhi to the Taj Mahal at Agra and on through the royal cities of Rajasthan — Jaipur, Pushkar, Jodhpur and Udaipur — with forts, palaces, lakes and temples along the way, and the great fort of Chittorgarh on the last day.'
  };
  const tdMid = [...new Set(stops.slice(1, -1).map(x => x.replace(/\(.*?\)/g, '').trim()).filter(x => x && !/home\s*town/i.test(x) && x !== stops[0] && x !== stops[stops.length - 1]))];
  const tdList = a => a.length > 1 ? a.slice(0, -1).join(', ') + ' and ' + a[a.length - 1] : (a[0] || '');
  const tdReal = stops.filter(x => !/home\s*town/i.test(x));
  const tdEnd = tdReal[tdReal.length - 1], tdStart = tdReal[0];
  if (tdMid[tdMid.length - 1] === tdEnd) tdMid.pop();
  // highlights: the sights named in bold in the day texts (a couple per day, spread over the tour)
  const tdStopRe = new RegExp('^(' + stops.map(x => x.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|') + ')$', 'i');
  const tdSkip = /home ?town|airport|railway|station|hotel|emporium|show|mohabbat|market|bazaar|^old and new|cruise|flight|ride|^day\b|resort/i;
  // one sight per day, then up to seven spread evenly over the whole tour
  const tdPer = d.days.map(day => { for (const p of (day.paras || [])) for (const seg of p) {
      const t = String(seg.text || '').replace(/\s+/g, ' ').trim().replace(/[,.:;]+$/, '');
      if (seg.bold && t.length >= 4 && t.length <= 40 && !tdSkip.test(t) && !tdStopRe.test(t)) return t; } return null; }).filter(Boolean)
    .filter((x, i, arr) => arr.indexOf(x) === i);
  const tdHl = tdPer.length > 7 ? [0, 1, 2, 3, 4, 5, 6].map(i => tdPer[Math.round(i * (tdPer.length - 1) / 6)]) : tdPer;
  const tdLead = TD_DESC[d.url] || ('A private ' + tdDays + '-day tour from ' + tdStart
      + (tdMid.length ? ' through ' + tdList(tdMid.slice(0, 6)) + (tdMid.length > 6 ? ' and more' : '') : '')
      + (tdEnd && tdEnd !== tdStart ? ', ending in ' + tdEnd : (tdEnd ? ' and back to ' + tdEnd : '')) + '.');
  const tdTail = ' You travel in your own air-conditioned car with an English-speaking driver, stay in hand-picked hotels, and every part of the plan can be changed to suit you.';
  // two to three lines on a laptop: fewer highlights when the lead is long
  let tdDesc = tdLead + tdTail;
  for (let k = Math.min(7, tdHl.length); k >= 3; k--) {
    const pick = k === tdHl.length ? tdHl : [...Array(k).keys()].map(i => tdHl[Math.round(i * (tdHl.length - 1) / (k - 1))]);
    const t = tdLead + ' Highlights include ' + tdList(pick) + '.' + tdTail;
    if (t.length <= 440) { tdDesc = t; break; }
  }
%>
<% // the top photos: the main one, then two from the route that no day uses (no picture twice on the page)
   const topUsed = new Set([heroImg].concat(dayPhotos.filter(Boolean)));
   // a photo named after a city is used only when that city is on this route
   const routeTxt = stops.join(' ').toLowerCase();
   const onRoute = f => { const c = (String(f).match(/(jaisalmer|jodhpur|jaipur|udaipur|bikaner|pushkar|delhi|agra|varanasi|kerala|goa|ladakh|mysore|madurai|darjeeling|amritsar)/i) || [])[1]; return !c || routeTxt.includes(c.toLowerCase()); };
   const topPics = [heroImg].concat([...new Set(stops.slice().reverse().flatMap(st => photoChoices(st)).concat(photoCandidates(d.heading + ' ' + d.route)))].filter(x => !topUsed.has(x) && onRoute(x)).slice(0, 2)); %>
<section id="top" class="tp-top td2-top">
  <div class="tp-wrap">
    <div class="tp-gallery tp-g<%= topPics.length %> td2-gallery">
      <% topPics.forEach((g, i) => { %><figure class="tp-gi"><img src="<%= g %>" alt="<%= i ? '' : (d.heroAlt || d.heading) %>"<%= i ? ' loading="lazy"' : '' %>></figure><% }) %>
    </div>
    <nav aria-label="Breadcrumb" class="tp-crumbs td2-crumbs">
      <% d.breadcrumb.forEach((b, i) => { %><% if (i) { %><span>›</span><% } %><% if (b.href) { %><a href="<%= b.href %>"><%= b.label %></a><% } else { %><strong><%= b.label %></strong><% } %><% }) %>
    </nav>
    <h1 class="tp-title td2-title"><%= dhWords.join(' ') %><% if (dhLast) { %> <em><%= dhLast %></em><% } %></h1>
    <ul class="td2-facts">
      <li><%- I.clock %><%= tdNights %> Nights / <%= tdDays %> Days</li>
      <li><%- I.pin %><%= stops.length %> stops · <%= stops[0] %> to <%= stops[stops.length - 1] %></li>
    </ul>
    <p class="td2-desc"><%= tdDesc %></p>
  </div>
</section>

<nav class="tj" aria-label="Tour sections">
  <div class="tj-inner">
    <% jump.forEach(j => { %><a href="<%= j[0] %>"><%= j[1] %><% if (j[2]) { %><span><%= j[2] %></span><% } %></a><% }) %>
    <a href="<%= d.enquire.href %>" class="tj-cta"><%= d.enquire.label %> <span>→</span></a>
  </div>
</nav>

<div class="tp-body td2-body">
  <div class="tp-main">

    <section id="itinerary" class="tp-sec td2-sec">
      <p class="td2-rline" aria-label="Route"><span class="td2-rline-l"><%- I.pin %>Route</span><% stops.forEach((s, j) => { const edge = j === 0 || j === stops.length - 1; %><span class="td2-rstop<%= edge ? ' td2-redge' : '' %>"><%= s %></span><% if (j < stops.length - 1) { %><i aria-hidden="true">→</i><% } %><% }) %></p>
      <ol class="td2-days">
        <% let tdSide = 0; d.days.forEach((day, i) => { const [num, ...rest] = day.day.split(' '); const ph = dayPhotos[i]; const flip = ph && (tdSide++ % 2 === 1); %>
        <li class="td2-day td2-wrap<%= ph ? '' : ' td2-noimg' %><%= flip ? ' td2-flip' : '' %>">
          <% if (ph) { %><figure class="td2-dfig"><img src="<%= ph %>" alt="" loading="lazy"></figure><% } %>
          <div class="td2-dhead">
            <span class="td2-dn"><small><%= rest.join(' ') || 'Day' %></small><b><%= num %></b></span>
            <div>
              <h3 class="td2-dt"><%= day.title %></h3>
              <% if (day.eta) { %><span class="td2-eta"><%- I.clock %><%= day.eta %></span><% } %>
            </div>
          </div>
          <% (day.paras || [day.body]).forEach((para, k) => { if (isInfo(para, k)) return; %><p class="td2-p"><%- rs(para, 'color:#336699;font-weight:700') %></p><% }) %>
          <% if (day.note) { %><p class="td2-note"><%- rs(day.note, 'font-weight:800') %></p><% } %>
        </li>
        <% }) %>
      </ol>
    </section>

    <section id="details" class="tp-sec td2-sec td2-lists td2-three">
      <% [['hotels', d.hotels], ['flights', d.flights]].forEach(([key, tb]) => { if (!tb) return; %>
      <div class="td2-list td2-table" id="<%= key %>">
        <h3 class="td2-lt"><%= tb.title %></h3>
        <% if (tb.text) { %><p class="td2-ttext"><%= tb.text %></p><% } %>
        <div class="tt-scroll"><table class="tt-table">
          <thead><tr><% tb.columns.forEach(c => { %><th scope="col"><%= c %></th><% }) %></tr></thead>
          <tbody><% tb.rows.forEach(r => { %><tr><% r.forEach((cell, ci) => { %><td data-label="<%= tb.columns[ci] %>"><%= cell %></td><% }) %></tr><% }) %></tbody>
        </table></div>
        <% if (tb.note) { %><p class="td2-ttext"><%= tb.note %></p><% } %>
      </div>
      <% }) %>
      <% if (incl) { %>
      <div class="td2-list td2-in" id="inclusions">
        <h3 class="td2-lt"><%= incl.title %></h3>
        <ul><% incl.items.forEach(it => { %><li><%- rs(it, 'font-weight:700') %></li><% }) %></ul>
      </div>
      <% } %>
      <% if (excl) { %>
      <div class="td2-list td2-ex" id="excludes">
        <h3 class="td2-lt"><%= excl.title %></h3>
        <ul><% excl.items.forEach(it => { %><li><%- rs(it, 'font-weight:700') %></li><% }) %></ul>
      </div>
      <% } %>
      <% notes.forEach((nb, ni) => { %>
      <div class="td2-list td2-notes" id="note-<%= ni %>">
        <h3 class="td2-lt"><%= nb.title %></h3>
        <ul><% nb.items.forEach(it => { %><li><%- rs(it, 'font-weight:700') %></li><% }) %></ul>
      </div>
      <% }) %>
    </section>
  </div>

  <aside class="tp-side td2-side" id="pricing">
    <div class="pr-card td2-price" data-pricing>
      <div class="pr-head">
        <span class="pr-mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg></span>
        <h3 class="pr-title"><%= pricing.title %></h3>
      </div>
      <% if (pricing.text) { %><p class="td2-pintro"><%= pricing.text %></p><% } %>
      <% const sel = priced.find(t => t.stars === 3) || priced[0] || tiers[0]; const hotelOf = t => t ? t.label.replace(/:$/, '') : ''; %>
      <% if (priced.length) { %>
      <div class="pr-display" aria-live="polite">
        <div class="pr-stars<%= sel.stars ? '' : ' is-hidden' %>" data-stars><%= '★'.repeat(sel.stars) %><span><%= '★'.repeat(Math.max(0, 5 - sel.stars)) %></span></div>
        <div class="pr-price" data-price><%= sel.total %></div>
        <div class="pr-unit" data-unit><%= tdUnit %></div>
        <div class="pr-bar is-hidden" data-bar><div class="pr-track"><span class="pr-fill" data-fill></span></div></div>
      </div>
      <p class="td2-pick">Choose your hotels</p>
      <div class="pr-tiers td2-tiers" role="radiogroup" aria-label="Hotel category">
        <% priced.forEach(t => { %>
        <button type="button" role="radio" class="pr-tier<%= t === sel ? ' on' : '' %>" aria-checked="<%= t === sel %>"
          data-label="<%= hotelOf(t) %>" data-stars="<%= t.stars %>" data-range="<%= t.total %>" data-unit="<%= tdUnit %>" data-priced="false" data-left="0" data-width="0">
          <strong><%= hotelOf(t) %> hotels</strong>
          <span class="td2-tier-total"><%= t.total %></span>
          <span class="td2-tier-day"><%= t.perDay %></span>
        </button>
        <% }) %>
      </div>
      <% } %>
      <% const tdOther = tiers.filter(t => !t.priced); if (tdOther.length) { %>
      <ul class="td2-other"><% tdOther.forEach(t => { %><li><strong><%= hotelOf(t) || 'Price' %></strong><span><%= t.rest %></span></li><% }) %></ul>
      <% } %>
      <% if (!pricing.text) { %><p class="pr-note td2-pnote"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><circle cx="12" cy="7.6" r=".6" fill="currentColor"/></svg><span>Per person, two sharing a double room. Your final quote depends on hotels, dates and group size.</span></p><% } %>
      <a class="pr-cta" data-cta data-base="<%= d.enquire.href %>" href="<%= priced.length ? withHotel(d.enquire.href, hotelOf(sel)) : d.enquire.href %>"><%= d.enquire.label %> <span>→</span></a>
    </div>
    <div class="tp-help">
      <b>Questions about this tour?</b>
      <a href="<%= tel %>"><%- I.phone %><%= hq.phones[0] %></a>
      <a href="mailto:<%= hq.email %>"><%- I.mail %><%= hq.email %></a>
      <a href="/#faq" class="td2-policy-l"><%- ico('<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h6M10 17h6"/>') %>Booking &amp; cancellation policy <span aria-hidden="true">→</span></a>
    </div>
  </aside>
</div>

<% if (tdFrom) { %>
<div class="tp-mbar">
  <div class="tp-mbar-p"><small>From</small><b><%= tdUsd(tdFrom) %></b><span>per person</span></div>
  <a href="<%= d.enquire.href %>" class="tp-mbar-go"><%= d.enquire.label %> <span>→</span></a>
</div>
<% } %>

<% const catCrumb = d.breadcrumb[d.breadcrumb.length - 2] || {}; %>
<%- include('partials/popular-tours', { current: d.url, tours: similarTours(d.url, catCrumb.href, 3), heading: 'Related <em>Tours</em>', base: 'More journeys like this one, from our ' + (catCrumb.label || 'India tours') + '.', allHref: '/itineraries', allLabel: 'View all Tours', avoid: dayPhotos.filter(Boolean).concat([d.heroSrc], topPics), note: false }) %>


<%- include('partials/page-footer', { footCols: d.footCols, enquireHref: d.enquire.href }) %>

</div>
</div>
<script src="/js/tour-detail.js" defer></script>
</body>
</html>
