<%- include('partials/head') %>
<%
  const words = d.heading.split(' ');
  const lastWord = words.pop();
  const routeParts = d.route.split(/\s+([-–])\s+/);   // keep whichever separator the original used
  const stops = routeParts.filter((x, i) => i % 2 === 0), seps = routeParts.filter((x, i) => i % 2 === 1);
  // Renders [{ text, bold }] segments; bold parts use `b` as their style.
  const rs = (segs, b) => segs.map(s => s.bold ? '<strong style="' + b + '">' + escapeFn(s.text) + '</strong>' : escapeFn(s.text)).join('');
  const escapeFn = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const h3 = "font-family:'Bricolage Grotesque',sans-serif;font-size:22px;font-weight:600;letter-spacing:-.02em;margin:0 0 14px;color:#0B1B33";
  const pricing = d.details.find(b => /pric|cost/i.test(b.title)) || { title: '', text: '', items: [] };
  // Price lines come in several shapes on the originals: "3-Star: $85 - $100 per person per day",
  // "3-Star Hotels: USD 90 - USD 100 per person per day.", "5-Star: Available on request",
  // "Superior Category: ...", and sometimes an unbolded label. The wording is always shown as-is.
  const tiers = pricing.items.map(it => {
    const whole = it.map(x => x.text).join('').trim();
    const boldLabel = (it.find(x => x.bold) || { text: '' }).text.trim();
    const label = boldLabel || (whole.match(/^[^:]+:/) || [''])[0];
    const rest = boldLabel ? it.filter(x => !x.bold).map(x => x.text).join('').trim() : whole.slice(label.length).trim();
    // also "USD 90-100", "US$90–100" and "$90–$100" (the itinerary documents of Oct 2026)
    const m = rest.match(/^((?:US\$\s*|\$\s*|USD\s*)(\d+)\s*[-–]\s*(?:US\$\s*|\$\s*|USD\s*)?(\d+)\s*\+?)\s*(.*)$/);
    const toUsd = s => String(s).replace(/US\$\s*/g, '$').replace(/(\$|USD)\s*([\d,]+)\s*[-–]\s*(?:\$|USD)?\s*([\d,]+)/g, 'USD $2 - $3').replace(/\$\s*/g, 'USD ');
    return { label, rest: toUsd(rest), range: toUsd(m ? m[1].trim() : rest), unit: m ? m[4] : '', priced: !!m, lo: m ? +m[2] : 0, hi: m ? +m[3] : 0, stars: parseInt(label, 10) || 0 };
  }).filter(t => t.label || t.rest);
  const priced = tiers.filter(t => t.priced);
  const tierMin = priced.length ? Math.min(...priced.map(t => t.lo)) : 0, tierMax = priced.length ? Math.max(...priced.map(t => t.hi)) : 0;
  const cur = 'USD ';
  tiers.forEach(t => {
    const span = Math.max(1, tierMax - tierMin);
    t.left = t.priced ? ((t.lo - tierMin) / span * 100).toFixed(1) : 0;
    t.width = t.priced ? Math.max(6, (t.hi - t.lo) / span * 100).toFixed(1) : 0;
  });
  // Enquiry link that also carries the chosen hotel category
  const withHotel = (href, hotel) => href.replace(/(#|$)/, m => (href.includes('?') ? '&' : '?') + 'hotel=' + encodeURIComponent(hotel) + m);
  const rest = d.details.filter(b => b !== pricing);
  const incl = rest.find(b => /includes/i.test(b.title));
  const excl = rest.find(b => /excludes/i.test(b.title));
  const notes = rest.filter(b => b !== incl && b !== excl);
  const pad = n => (n < 10 ? '0' : '') + n;
  const svg = p => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + p + '</svg>';
  const NOTE_ICONS = [
    { re: /closed|weather|schedule/i, warn: true, icon: svg('<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2"/><path d="M9 2h6"/>') },
    { re: /additional|upgrade|arranged/i, icon: svg('<path d="M12 3v18M3 12h18"/>') },
    { re: /price|cost|peak/i, icon: svg('<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>') },
    { re: /customi[sz]ed|modified|private/i, icon: svg('<path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/>') }
  ];
  const noteKind = segs => { const t = segs.map(x => x.text).join(''); return NOTE_ICONS.find(k => k.re.test(t)) || { icon: svg('<circle cx="12" cy="12" r="9"/><path d="M12 11v5"/>') }; };
  // Includes / excludes column look
  const tone = {
    in: { accent: '#1F8A55', soft: '#E8F6EE', ring: '#BFE6CF', icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>' },
    ex: { accent: '#C2412D', soft: '#FDEEEA', ring: '#F6CFC6', icon: '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>' }
  };
%>
<div style="width:100%;overflow-x:clip;background:#F4F7FB">
<div id="mk-frame" class="<%= typeof frameClass !== 'undefined' ? frameClass : '' %> td2 it2" style="container-type:inline-size;width:100%;background:#F4F7FB">

<%- include('partials/page-header', { nav: d.nav, enquireHref: d.enquire.href }) %>

<%
  const heroImg = d.photo || photoFor([d.heading, d.url, d.route]);
  const jump = [['#itinerary', 'Itinerary', d.days.length]];
  if (pricing.title) jump.push(['#pricing', pricing.title]);
  if (d.hotels) jump.push(['#hotels', d.hotels.title]);
  if (incl) jump.push(['#inclusions', incl.title]);
  if (d.flights) jump.push(['#flights', d.flights.title]);
  if (excl) jump.push(['#excludes', excl.title]);
  notes.forEach((nb, i) => jump.push(['#note-' + i, nb.title]));
  // A photo for each day, as in the printed itineraries: the place the day is about, never the hero or a repeat
  const usedPh = new Set([heroImg]);
  // the place the day ends in comes first ("Tirupati – Varanasi" → Varanasi), then the others in the title
  const dayPhoto = day => {
    const places = String(day.title).replace(/^[^:]*\d(st|nd|rd|th)[^:]*:/i, '').split(/\s*[-–]\s*/).reverse();
    for (const pl of places) { const p = photoChoices(pl).find(x => !usedPh.has(x)); if (p) { usedPh.add(p); return p; } }
    // otherwise a sight named in bold in the day's text (Taj Mahal, Periyar…)
    for (const para of (day.paras || [])) for (const seg of para) {
      const t = String(seg.text || '').trim();
      if (!seg.bold || t.length < 4 || t.length > 50 || /airport|station|hotel|note/i.test(t)) continue;
      const p = photoChoices(t).find(x => !usedPh.has(x)); if (p) { usedPh.add(p); return p; }
    }
    return null;
  };
  // "Bangalore: Capital of Karnataka…" — a paragraph that opens with a bold place name is the place's background note (not shown)
  const isInfo = (para, k) => k > 0 && para[0] && para[0].bold && /:\s*$/.test(para[0].text);
  let photoSide = 0;
%>
<% const dhWords = d.heading.trim().split(' '); const dhLast = dhWords.length > 1 ? dhWords.pop() : '';
   const dhFrom = priced.length ? 'USD ' + tierMin : '';
   const dhUnit = priced.length ? (priced.find(t => t.lo === tierMin) || priced[0]).unit : '';
   const dhFixed = !priced.length && tiers.length === 1 ? (tiers[0].rest.match(/^(USD\s*[\d,]+)\s*(.*)$/) || null) : null; %>
<%
  // tour page v5: photos for the days first (the gallery uses the first two), then the page
  const dayPhotos = d.days.map(dayPhoto);
  const gallery = [heroImg].concat(dayPhotos.filter(Boolean).slice(0, 2));
  const hq = footer.hq, tel = 'tel:' + hq.phones[0].replace(/[^0-9+]/g, '');
  const ico = p => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + p + '</svg>';
  const I = {
    clock: ico('<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>'),
    cal: ico('<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>'),
    pin: ico('<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>'),
    flag: ico('<path d="M5 21V4M5 4h11l-2 4 2 4H5"/>'),
    end: ico('<circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/>'),
    phone: ico('<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>'),
    mail: ico('<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>')
  };
  const priceLine = dhFrom ? { pre: 'From', amt: dhFrom, unit: dhUnit } : dhFixed ? { pre: tiers[0].label.replace(/:$/, ''), amt: dhFixed[1].replace(/\s+/g, ' '), unit: dhFixed[2] } : null;
%>
<%
  // v2 (12 Oct 2026, this tour only): every fact once; package prices (per day × nights) so they match
  // the tour lists; the days in a zig-zag (photo right, then left); plain lists for includes / excludes / notes.
  const tdNights = +((String(d.duration).match(/(\d+)\s*Nights?/i) || [])[1] || 0);
  const tdUsd = v => 'USD ' + Number(v).toLocaleString('en-US');
  priced.forEach(t => {
    t.totalLo = t.lo * tdNights; t.totalHi = t.hi * tdNights; t.plus = /\+/.test(t.range);
    t.total = tdUsd(t.totalLo) + ' – ' + Number(t.totalHi).toLocaleString('en-US') + (t.plus ? '+' : '');
    t.perDay = tdUsd(t.lo) + ' – ' + t.hi + (t.plus ? '+' : '') + ' a day';
  });
  const tdFrom = priced.length && tdNights ? Math.min(...priced.map(t => t.totalLo)) : 0;
  const tdUnit = 'per person · ' + tdNights + ' nights';
  const tdDays = d.days.length;
  // the tour's category (its breadcrumb's list page): the other tours in it, and the tours before and after this one
  const tdCat = tourNav.inCategory(d.url, (d.breadcrumb[d.breadcrumb.length - 2] || {}).href);
  // the short description under the title: written by hand for some tours, otherwise built from the route
  const TD_DESC = {
    '/rajasthan_holiday_tour_packages': 'A private 11-day journey from Delhi to the Taj Mahal at Agra and on through the royal cities of Rajasthan — Jaipur, Pushkar, Jodhpur and Udaipur — with forts, palaces, lakes and temples along the way, and the great fort of Chittorgarh on the last day.'
  };
  const tdMid = [...new Set(stops.slice(1, -1).map(x => x.replace(/\(.*?\)/g, '').trim()).filter(x => x && !/home\s*town/i.test(x) && x !== stops[0] && x !== stops[stops.length - 1]))];
  const tdList = a => a.length > 1 ? a.slice(0, -1).join(', ') + ' and ' + a[a.length - 1] : (a[0] || '');
  const tdReal = stops.filter(x => !/home\s*town/i.test(x));
  const tdEnd = tdReal[tdReal.length - 1], tdStart = tdReal[0];
  if (tdMid[tdMid.length - 1] === tdEnd) tdMid.pop();
  // highlights: the sights named in bold in the day texts (a couple per day, spread over the tour)
  const tdStopRe = new RegExp('^(' + stops.map(x => x.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|') + ')$', 'i');
  const tdSkip = /home ?town|airport|railway|station|hotel|emporium|show|mohabbat|market|bazaar|^old and new|cruise|flight|ride|^day\b|resort/i;
  // one sight per day, then up to seven spread evenly over the whole tour
  const tdPer = d.days.map(day => { for (const p of (day.paras || [])) for (const seg of p) {
      const t = String(seg.text || '').replace(/\s+/g, ' ').trim().replace(/[,.:;]+$/, '');
      if (seg.bold && t.length >= 4 && t.length <= 40 && !tdSkip.test(t) && !tdStopRe.test(t)) return t; } return null; }).filter(Boolean)
    .filter((x, i, arr) => arr.indexOf(x) === i);
  const tdHl = tdPer.length > 7 ? [0, 1, 2, 3, 4, 5, 6].map(i => tdPer[Math.round(i * (tdPer.length - 1) / 6)]) : tdPer;
  const tdLead = TD_DESC[d.url] || ('A private ' + tdDays + '-day tour from ' + tdStart
      + (tdMid.length ? ' through ' + tdList(tdMid.slice(0, 6)) + (tdMid.length > 6 ? ' and more' : '') : '')
      + (tdEnd && tdEnd !== tdStart ? ', ending in ' + tdEnd : (tdEnd ? ' and back to ' + tdEnd : '')) + '.');
  const tdTail = ' You travel in your own air-conditioned car with an English-speaking driver, stay in hand-picked hotels, and every part of the plan can be changed to suit you.';
  // two to three lines on a laptop: fewer highlights when the lead is long
  let tdDesc = tdLead + tdTail;
  for (let k = Math.min(7, tdHl.length); k >= 3; k--) {
    const pick = k === tdHl.length ? tdHl : [...Array(k).keys()].map(i => tdHl[Math.round(i * (tdHl.length - 1) / (k - 1))]);
    const t = tdLead + ' Highlights include ' + tdList(pick) + '.' + tdTail;
    if (t.length <= 440) { tdDesc = t; break; }
  }
%>
<% const topPics = [heroImg]; %>
<%# (21 Oct 2026, client) the tour page in the reference layout (meruka-india-testing.netlify.app/itin_2, its default
    options): the banner; the breadcrumb in a thin blue strip under it; a full-width heading with the gold
    "Private Tours – No Sharing" tag, the description, the route and a facts line; then the days in boxes with one box
    of pricing, includes / excludes and notes under them, and the price box, the category's tours and the contact box
    on the right. %>
<%
  const it2Sym = {
    clock: '<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="2"/><path d="M10 5.5V10l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
    pin: '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 18s6-5.2 6-9.5a6 6 0 10-12 0C4 12.8 10 18 10 18z" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="10" cy="8.5" r="2.2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>',
    tag: '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10.5V4a1 1 0 011-1h6.5l7 7-7.5 7.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="7" cy="7" r="1.3" fill="currentColor"/></svg>',
    check: '<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8" fill="currentColor"/><path d="M6.5 10.2l2.5 2.5 4.5-5" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    cross: '<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8" fill="currentColor"/><path d="M7 7l6 6M13 7l-6 6" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>',
    info: '<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M10 9v5M10 6.2v.1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
    phone: '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 3h3l1.5 4-2 1.2a9 9 0 004.3 4.3L13 10.5l4 1.5v3a2 2 0 01-2 2A12 12 0 013 5a2 2 0 012-2z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
    mail: '<svg viewBox="0 0 20 20" aria-hidden="true"><rect x="2.5" y="4.5" width="15" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3 6l7 5 7-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
    doc: '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 2.5h6l4 4v11H5z M11 2.5v4h4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>'
  };
  const it2Sel = priced.find(t => t.stars === 3) || priced[0];
  const it2Hotel = t => t ? t.label.replace(/:$/, '').replace(/\s*hotels?$/i, '') : '';
  const it2Code = tourCode(d.url);
  const it2Other = tiers.filter(t => !t.priced);
  const it2Real = stops.filter(x => !/home\s*town/i.test(x));
  // (21 Oct 2026, client) the last day, when it ends with a flight: the title says "… - Hometown by Air" and the
  // separate one-line subheading ("Delhi - Hometown by Air") is not shown
  const it2Sub = para => para && para.length === 1 && para[0].bold && para[0].text.length < 70 && /home\s*town|by air|departure/i.test(para[0].text);
  const it2Txt = day => (day.paras || []).map(p => p.map(x => x.text).join('')).join(' ');
  // how the guest leaves on the last day: by air (airport / flight), by train (railway station / train) or by bus
  const it2Mode = day => { const t = it2Txt(day); return /airport|flight|by air/i.test(t) ? 'Air' : /railway|train/i.test(t) ? 'Train' : /bus/i.test(t) ? 'Bus' : ''; };
  const it2Title = (day, i) => { const m = i === d.days.length - 1 && !/home\s*town/i.test(day.title) ? it2Mode(day) : ''; return m ? day.title + ' - Hometown by ' + m : day.title; };
%>
<%- include('partials/photo-hero', { title: d.heading, img: heroImg, alt: d.heroAlt || d.heading, part: 'media' }) %>
<div class="it2-cb"><div class="it2-in"><nav aria-label="Breadcrumb"><ol class="it2-crumbs"><% d.breadcrumb.forEach((c, i) => { const last = i === d.breadcrumb.length - 1; %><li<%- last ? ' aria-current="page"' : '' %>><% if (c.href && !last) { %><a href="<%= c.href %>"><%= c.label %></a><% } else { %><%= c.label %><% } %></li><% }) %></ol></nav></div></div>


<div class="it2-wrap">
  <div class="it2-layout">
    <main class="it2-main">
      <header id="top" class="it2-hd it2-card">
  <div class="it2-tt"><h1><%= words.join(' ') %> <em><%= lastWord %></em></h1></div>
  <%- pvtLineFull %>
  <p class="it2-ds"><%= tdDesc %></p>
  <div class="it2-rt"><%- it2Sym.pin %><div><b>Route:</b> <% stops.forEach((s, j) => { %><%= s %><% if (j < stops.length - 1) { %> <i aria-hidden="true">→</i> <% } %><% }) %></div></div>
  <div class="it2-fx">
    <div class="it2-f"><span><%- it2Sym.clock %><%= tdNights %> Nights / <%= tdDays %> Days</span><span><%- it2Sym.pin %><%= it2Real.length %> Stops</span><% if (it2Code) { %><span class="it2-fcode">Tour Code: <%= it2Code %></span><% } %></div>
    <% if (tdFrom) { %><div class="it2-pr"><small>Starts from</small><strong><%= tdUsd(tdFrom) %></strong><span>per person</span></div><% } %>
  </div>
</header>
      <% let it2Side = 0; d.days.forEach((day, i) => { const ph = dayPhotos[i]; const flip = ph && (it2Side++ % 2 === 1); %>
      <section class="it2-day">
        <div class="it2-dh"><span class="it2-badge"><%= day.day %></span><h3><%= it2Title(day, i) %></h3><% if (day.eta) { %><span class="it2-dist"><%= day.eta %></span><% } %></div>
        <div class="it2-db"><% if (ph) { %><img class="it2-pic<%= flip ? ' r' : '' %>" src="<%= ph %>" alt="" loading="lazy"><% } %>
          <% (day.paras || [day.body]).forEach((para, k) => { if (isInfo(para, k) || (i === d.days.length - 1 && k === 0 && it2Sub(para))) return; %><p><%- rs(para, '') %></p><% }) %>
          <% if (day.note) { %><p class="it2-note"><%- rs(day.note, '') %></p><% } %>
        </div>
      </section>
      <% }) %>

      <section class="it2-info" id="pricing">
        <% if (it2Sel && it2Sel.totalLo) { %>
        <div class="it2-sec it2-pg">
          <div class="it2-pl"><small>Starts from</small><div><strong><%= tdUsd(it2Sel.totalLo) %></strong></div><span>per person</span></div>
          <div class="it2-pd"><p class="it2-pin"><span>The price quote includes a <b>private tour</b> with <b><%= it2Hotel(it2Sel) || '3-Star' %> hotels</b>, a <b>private car with driver</b>, and other services as mentioned below.</span></p></div>
        </div>
        <% } else if (pricing.title) { %>
        <div class="it2-sec"><h3><%= pricing.title %></h3><% if (pricing.text) { %><p><%= pricing.text %></p><% } %><% if (it2Other.length) { %><ul class="it2-list it2-yes"><% it2Other.forEach(t => { %><li><%- it2Sym.info %><span><b><%= it2Hotel(t) || 'Price' %>:</b> <%= t.rest %></span></li><% }) %></ul><% } %></div>
        <% } %>
        <% [['hotels', d.hotels], ['flights', d.flights]].forEach(([key, tb]) => { if (!tb) return; %>
        <div class="it2-sec" id="<%= key %>">
          <h3><%= tb.title %></h3>
          <% if (tb.text) { %><p><%= tb.text %></p><% } %>
          <div class="tt-scroll"><table class="tt-table">
            <thead><tr><% tb.columns.forEach(c => { %><th scope="col"><%= c %></th><% }) %></tr></thead>
            <tbody><% tb.rows.forEach(r => { %><tr><% r.forEach((cell, ci) => { %><td data-label="<%= tb.columns[ci] %>"><%= cell %></td><% }) %></tr><% }) %></tbody>
          </table></div>
          <% if (tb.note) { %><p><%= tb.note %></p><% } %>
        </div>
        <% }) %>
        <% if (incl || excl) { %>
        <div class="it2-sec it2-two">
          <% if (incl) { %><div id="inclusions"><h3><%= incl.title %></h3><ul class="it2-list it2-yes"><% incl.items.forEach(it => { %><li><%- it2Sym.check %><span><%= it.map(x => x.text).join('') %></span></li><% }) %></ul></div><% } %>
          <% if (excl) { %><div id="excludes"><h3><%= excl.title %></h3><ul class="it2-list it2-no"><% excl.items.forEach(it => { %><li><%- it2Sym.cross %><span><%= it.map(x => x.text).join('') %></span></li><% }) %></ul></div><% } %>
        </div>
        <% } %>
        <% notes.forEach((nb, ni) => { %>
        <div class="it2-sec" id="note-<%= ni %>">
          <h3><%= nb.title %></h3>
          <ul class="it2-list it2-yes"><% nb.items.forEach(it => { %><li><%- it2Sym.info %><span><%= it.map(x => x.text).join('') %></span></li><% }) %></ul>
        </div>
        <% }) %>
      </section>
    </main>

    <aside class="it2-side">
      <div class="it2-price" data-it2-price>
        <div class="it2-ph"><span class="it2-ico"><%- it2Sym.tag %></span><h4><%= pricing.title || 'Tour Pricing Details' %></h4></div>
        <% if (pricing.text) { %><p class="it2-small"><%= pricing.text %></p><% } %>
        <% if (priced.length) { %>
        <div class="it2-total"><div class="it2-stars" data-it2-stars><%= '★'.repeat(it2Sel.stars) %></div><p class="it2-amt" data-it2-amt><%= it2Sel.total %></p><p class="it2-per"><%= tdUnit %></p></div>
        <p class="it2-lab">Choose your hotels</p>
        <div class="it2-hotels">
          <% priced.forEach(t => { %>
          <button type="button" class="it2-hotel" aria-pressed="<%= t === it2Sel %>" data-total="<%= t.total %>" data-stars="<%= t.stars %>" data-hotel="<%= it2Hotel(t) %>"><div><strong><%= it2Hotel(t) %> hotels</strong><small><%= t.perDay %></small></div><span><%= t.total %></span></button>
          <% }) %>
        </div>
        <% } %>
        <% if (it2Other.length && priced.length) { %><ul class="it2-other"><% it2Other.forEach(t => { %><li><b><%= it2Hotel(t) || 'Price' %>:</b> <%= t.rest %></li><% }) %></ul><% } %>
        <p class="it2-lab">Price includes</p>
        <ul class="it2-inc">
          <li><%- it2Sym.check %><span>Hotel accommodation on twin sharing basis</span></li>
          <li><%- it2Sym.check %><span>Air-conditioned car with driver throughout sightseeing</span></li>
          <li><%- it2Sym.check %><span>Transport service from arrival until final departure</span></li>
        </ul>
        <a class="it2-btn ph-btn ph-btn-gold" data-it2-cta data-base="<%= d.enquire.href %>" href="<%= it2Sel ? withHotel(d.enquire.href, it2Hotel(it2Sel)) : d.enquire.href %>"><%= d.enquire.label %> <span aria-hidden="true">→</span></a>
        <p class="it2-fine">The above quote may vary 10–15% according to travel period, season, festivals, etc.</p>
      </div>

      <% if (tdCat && tdCat.tours.length > 1) { %>
      <nav class="it2-more" aria-label="More <%= tdCat.title %>">
        <h4>More <%= tdCat.title %></h4>
        <% tdCat.tours.slice(0, 8).forEach((t, i) => { const on = i === tdCat.index; %><a class="t<%= on ? ' on' : '' %>" href="<%= t.href %>"<%- on ? ' aria-current="page"' : '' %>><%= t.name %><small><%= String(t.duration || '').replace(/\s*[-–]\s*/, ' / ') %></small></a><% }) %>
        <p class="it2-morenote">*Starting price per person for the whole tour, two people sharing a room in 3-star hotels.</p>
      </nav>
      <% } %>

      <div class="it2-ask">
        <h5>Questions about this tour?</h5>
        <a href="<%= tel %>"><span class="it2-ico"><%- it2Sym.phone %></span><%= hq.phones[0] %></a>
        <a href="mailto:<%= hq.email %>"><span class="it2-ico"><%- it2Sym.mail %></span><%= hq.email %></a>
        <a href="/#faq"><span class="it2-ico"><%- it2Sym.doc %></span>Booking &amp; cancellation policy<span class="go" aria-hidden="true">→</span></a>
      </div>
    </aside>
  </div>
</div>
<script>
(function () {   // the hotel buttons change the price, the stars, the first "Price includes" line and the enquiry link
  var box = document.querySelector('[data-it2-price]'); if (!box) return;
  var hs = box.querySelectorAll('.it2-hotel'), amt = box.querySelector('[data-it2-amt]'), st = box.querySelector('[data-it2-stars]'),
      inc = box.querySelector('[data-it2-inc]'), cta = box.querySelector('[data-it2-cta]');
  hs.forEach(function (b) { b.addEventListener('click', function () {
    hs.forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
    if (amt) amt.textContent = b.dataset.total;
    if (st) st.textContent = '★★★★★'.slice(0, +b.dataset.stars);
    if (inc) inc.textContent = b.dataset.hotel;
    if (cta) { var base = cta.dataset.base, h = encodeURIComponent(b.dataset.hotel); cta.href = base.replace(/(#|$)/, function (m) { return (base.indexOf('?') > -1 ? '&' : '?') + 'hotel=' + h + m; }); }
  }); });
})();
</script>

<% if (tdFrom) { %>
<div class="tp-mbar">
  <div class="tp-mbar-p"><small>From</small><b><%= tdUsd(tdFrom) %></b><span>per person · Private, no sharing</span></div>
  <a href="<%= d.enquire.href %>" class="tp-mbar-go"><%= d.enquire.label %> <span>→</span></a>
</div>
<% } %>

<% const catCrumb = d.breadcrumb[d.breadcrumb.length - 2] || {}; %>
<%# (16 Oct 2026) Most Popular Tours in place of Related Tours: this tour's category is already listed in the sidebar %>
<%# (21 Oct 2026, client) no "Best Tours Packages of India" band on the tour pages %>


<%- include('partials/explore-india', { current: catCrumb.href, skipRegions: true, skipGuide: true }) %>

<%- include('partials/page-footer', { footCols: d.footCols, enquireHref: d.enquire.href }) %>

</div>
</div>
<script src="/js/tour-detail.js" defer></script>
</body>
</html>
