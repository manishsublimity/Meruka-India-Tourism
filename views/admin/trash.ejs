<%- include('_top', { pageTitle: 'Deleted items' }) %>
<div class="ad-top">
  <div><h1>Deleted items</h1><p>Tours, tour categories and pages you delete wait here: put them back on the website, or delete them for good.</p></div>
</div>
<% if (!items.length) { %><div class="card"><p class="hint" style="margin:0">Nothing has been deleted.</p></div><% } else { %>
<table class="tbl">
  <thead><tr><th>Name</th><th>Section</th><th>Deleted on</th><th class="acts">Actions</th></tr></thead>
  <tbody>
    <% items.forEach(t => { %>
    <tr><td><b><%= t.name %></b><br><small class="muted">/<%= t.id %></small></td><td><span class="pill pill-off"><%= kinds[t.kind].label %></span></td><td class="url"><%= new Date(t.at.slice(0, 10)).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
      <td class="acts"><button class="btn btn-s" type="button" data-restore data-kind="<%= t.kind %>" data-bin="<%= t.bin %>">Put back</button> <button class="btn btn-s btn-d" type="button" data-purge data-name="<%= t.name %>" data-kind="<%= t.kind %>" data-bin="<%= t.bin %>">Delete for good</button></td></tr>
    <% }) %>
  </tbody>
</table>
<% } %>
<%- include('_bottom', { scripts: ['/admin-assets/trash.js?v=3'] }) %>
