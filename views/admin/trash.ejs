<%- include('_top', { pageTitle: 'Deleted items' }) %>
<div class="ad-top">
  <div><h1>Deleted items</h1><p>Tours, tour categories and pages you delete are kept here and can be put back on the website.</p></div>
</div>
<% if (!items.length) { %><div class="card"><p class="hint" style="margin:0">Nothing has been deleted.</p></div><% } else { %>
<table class="tbl">
  <thead><tr><th>Item</th><th>Section</th><th>Deleted</th><th></th></tr></thead>
  <tbody>
    <% items.forEach(t => { %>
    <tr><td><b>/<%= t.id %></b></td><td><%= kinds[t.kind].label %></td><td class="url"><%= t.at.slice(0, 10) %></td>
      <td class="acts"><button class="btn btn-s" type="button" data-restore data-kind="<%= t.kind %>" data-bin="<%= t.bin %>">Put back</button></td></tr>
    <% }) %>
  </tbody>
</table>
<% } %>
<%- include('_bottom', { scripts: ['/admin-assets/trash.js?v=2'] }) %>
