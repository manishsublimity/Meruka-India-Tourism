<%
  // (23 Oct 2026) the admin panel's frame: a menu that shows only what the signed-in person's role allows (the server
  // checks every page and action as well), the person and their role at the foot, and a top bar.
  const IC = {
    home: '<path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/>',
    tours: '<path d="M4 18 9 6l4 8 3-5 4 9z"/>',
    pages: '<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 13h7M9 17h7"/>',
    blog: '<path d="M4 20h4L19 9l-4-4L4 16z"/><path d="m14 6 4 4"/>',
    reviews: '<path d="M4 5h16v11H9l-5 4z"/>',
    menus: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/>',
    foot: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 15h18"/>',
    settings: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"/>',
    seo: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
    enquiries: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
    users: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.5 3.3-5.5 6.5-5.5s5.7 2 6.5 5.5"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.6c2 .7 3.2 2.5 3.6 5.4"/>',
    activity: '<path d="M3 12h4l3-8 4 16 3-8h4"/>',
    trash: '<path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/>',
    cats: '<path d="M4 6h16M4 12h10M4 18h7"/>',
    map: '<path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2z"/><path d="M9 4v14M15 6v14"/>',
    guide: '<path d="M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2z"/><path d="M4 19V5M9 7h6M9 11h6"/>',
    attr: '<path d="m12 3 2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.6 6.6 19.5l1.2-6-4.5-4.2 6.1-.7z"/>',
    tools: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-.5-.5-2.5z"/>',
    look: '<circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"/>',
    user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4-6 8-6s7 2 8 6"/>',
    web: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
    out: '<path d="M15 4h4v16h-4M10 8l-4 4 4 4M6 12h10"/>'
  };
  const ic = n => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + IC[n] + '</svg>';
  const K = typeof kind !== 'undefined' ? kind : '', S = typeof id !== 'undefined' ? id : '';
  const onSingle = n => K === 'single' && S === n;
  const me = typeof admin !== 'undefined' && admin ? admin : { name: '', role: '' };
  const initials = String(me.name || '?').split(/\s+/).map(w => w[0]).join('').slice(0, 2).toUpperCase();
  const c = typeof can === 'function' ? can : () => false;
  const R = typeof roles !== 'undefined' ? roles : {};
  const SG = typeof singles !== 'undefined' ? singles : {};
  // the menu: [section label, [[label, icon, href, active, permission, badge]]]
  // (26 Oct 2026, client) like WordPress: content first, the two menus apart, the inbox, and the settings kept together at
  // the foot of the menu
  // (26 Oct 2026, client video II) Pages holds only the main pages; destinations and the travel guide have their own
  // place, the old text tour plans sit with the tours
  // (26 Oct 2026, client) the menu as the client listed it: Tours (add a tour, categories), the Four Regions one by one,
  // the travel guide's three sections, the footer's four columns. A group opens on its own page, or with its arrow.
  const PG = typeof pageGroup !== 'undefined' ? pageGroup : '', PS = typeof pageSection !== 'undefined' ? pageSection : '';
  const QS = typeof q !== 'undefined' && q ? q : {};
  const REG = [['North India', 'north'], ['South India', 'south'], ['East India', 'east'], ['West India', 'west']];
  const GSEC = [['Travelers Guide', 'travelers'], ['Attractions of India', 'attractions'], ['Travel Tools', 'tools']];
  // (27 Oct 2026, client) the Footer menu's entries are its tabs, the same names as in the page
  const FCOL = [['Logo & about', 'logo-and-about'], ['Link columns', 'link-columns'], ['Popular searches', 'popular-searches'], ['Social media', 'social-media']];
  const onDest = page === 'destinations' || (K === 'pages' && PG === 'places'), onGuide = page === 'travel-guide' || (K === 'pages' && PG === 'guide');
  const onFoot = onSingle('footer') || onSingle('menus') || onSingle('social');
  // [label, icon, href, on, permission, badge, (unused), kids: [label, href, on]]
  const MENU = [
    ['', [['Dashboard', 'home', '/admin', page === 'dashboard' || page === 'insights', '']]],
    ['Content', [
      ['Tours', 'tours', '/admin/tours', K === 'tours' || K === 'lists' || (K === 'pages' && PG === 'tours'), 'content', 0, 0, [
        ['Add tour', '/admin/tours#new', false], ['Categories', '/admin/lists', K === 'lists']]],
      ['Pages', 'pages', '/admin/pages', page === 'pages' || (K === 'single' && SG[S] && SG[S].page && S !== 'reviews'), 'content'],
      ['Four Regions', 'map', '/admin/destinations', onDest, 'content', 0, 0, REG.map(([l, k]) => [l, '/admin/destinations?region=' + k, onDest && (QS.region || PS) === k])],
      // (26 Oct 2026, client) the travel guide's three sections, each on its own, like a post type
      ...GSEC.map(([l, k], n) => [l, ['guide', 'attr', 'tools'][n], '/admin/travel-guide?section=' + k, onGuide && (QS.section || PS || 'travelers') === k, 'content']),
      ['Guest reviews', 'reviews', '/admin/reviews', page === 'reviews' || onSingle('reviews'), 'reviews']]],
    ['Menus', [
      ['Header menu', 'menus', '/admin/settings/header', onSingle('header'), 'menus'],
      ['Footer menu', 'foot', '/admin/settings/footer', onFoot, 'menus', 0, 0, FCOL.map(([l, n], i) => [l, '/admin/settings/footer?tab=' + n, onFoot && ((QS.tab || (QS.col ? 'link-columns' : '')) === n || (!QS.tab && !QS.col && i === 0))])]]],
    ['Inbox', [['Enquiries', 'enquiries', '/admin/enquiries', page === 'enquiries', 'enquiries', typeof unreadEnquiries !== 'undefined' ? unreadEnquiries : 0]]],
    ['Settings', [
      ['Site settings', 'settings', '/admin/settings', page === 'settings-hub' || page === 'look' || onSingle('seo'), 'settings'],
      ['Google & SEO', 'seo', '/admin/seo', page === 'seo', 'content'],
      ['Users', 'users', '/admin/users', page === 'users', 'users'], ['Activity log', 'activity', '/admin/activity', page === 'activity', 'users'],
      ['Deleted items', 'trash', '/admin/trash', page === 'trash', 'delete']]]
  ];
%><!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — ' : '' %>Meruka admin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/admin-assets/admin.css?v=37">
<%# (26 Oct 2026, client) the panel's look (light or dark, and its colour), chosen per browser in "Look of the panel" %>
<script>(function () { try { var rl = <%- JSON.stringify(typeof roleLook !== 'undefined' && roleLook ? roleLook : {}) %>, own = localStorage.getItem('mk-look'), l = own ? JSON.parse(own) : rl, d = document.documentElement, m = l.mode || 'light';
  if (m === 'auto') m = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  d.setAttribute('data-mode', m); d.setAttribute('data-accent', l.accent || 'blue'); } catch (e) {} })();</script>
</head>
<body>
<div class="ad">
  <aside class="ad-side">
    <a class="ad-brand" href="/admin" aria-label="Meruka India Tourism, admin home"><span class="ad-logo" aria-hidden="true"></span><span><b>MERUKA INDIA TOURISM</b><small>Website editor</small></span></a>
    <nav class="ad-nav" aria-label="Admin menu">
      <% MENU.forEach(([sect, links]) => { const shown = links.filter(l => !l[4] || c(l[4])); if (!shown.length) return; %>
      <% if (sect) { %><p class="ad-sect"><%= sect %></p><% } %>
      <% shown.forEach(([label, icon, href, on, , badge, , kids]) => { %>
      <% if (kids) { %>
      <div class="ad-tree<%= on ? ' open' : '' %>" data-tree="<%= href %>">
        <div class="ad-tree-h"><a class="ad-one<%= on ? ' on' : '' %>" href="<%= href %>"><%- ic(icon) %><span><%= label %></span></a><button type="button" class="ad-tree-t" aria-label="Show or hide <%= label %>" aria-expanded="<%= !!on %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button></div>
        <div class="ad-kids"><% kids.forEach(([kl, kh, kon]) => { %><a href="<%= kh %>" class="<%= kon ? 'on' : '' %>"<%- kon ? ' aria-current="page"' : '' %>><%= kl %></a><% }) %></div>
      </div>
      <% } else { %>
      <a class="ad-one<%= on ? ' on' : '' %>" href="<%= href %>"<%- on ? ' aria-current="page"' : '' %>><%- ic(icon) %><span><%= label %></span><% if (badge) { %><b class="ad-badge"><%= badge %></b><% } %></a>
      <% } %>
      <% }) %>
      <% }) %>
    </nav>
  </aside>
  <main class="ad-main">
    <%# (26 Oct 2026, client) the top bar: "+ New" (as in WordPress), the notifications and the signed-in person %>
    <% const NEW = [['content', '/admin/tours#new', 'Tour', 'A new tour with its days and prices'], ['content', '/admin/lists#new', 'Tour category', 'A page that lists tours'], ['content', '/admin/destinations#new', 'Destination page', 'A region, state or city'], ['content', '/admin/travel-guide#new', 'Travel guide page', 'A topic of the India Travel Guide'], ['reviews', '/admin/reviews#new', 'Guest review', 'What a guest wrote'], ['users', '/admin/users#new', 'User', 'A login for your team']].filter(n => c(n[0]));
       const NOTES = typeof notes !== 'undefined' ? notes : []; %>
    <div class="ad-bar"><button type="button" class="ad-burger" data-burger aria-label="Show or hide the menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M9 4v16"/></svg></button>
      <% if (typeof crumb !== 'undefined' && crumb) { %><a class="ad-crumb" href="<%= crumb[0] %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg><span>Back to <b><%= crumb[1] %></b></span></a><% } %>
      <div class="ad-bar-r">
        <% const NEW_IC = { Tour: 'tours', 'Tour category': 'cats', 'Destination page': 'map', 'Travel guide page': 'guide', 'Blog post': 'blog', 'Guest review': 'reviews', User: 'user' }; %>
        <% if (NEW.length) { %><details class="ad-new" data-pop><summary><svg class="nb-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>Quick add<span class="nb-kbd" title="Press N on any page">N</span></summary><div class="ad-menu ad-newgrid"><p class="nt-h">Quick add — from any page <span class="muted">(press N)</span></p><div class="ng"><% NEW.forEach(([, href, t, sub]) => { %><a href="<%= href %>"><i><%- ic(NEW_IC[t] || 'pages') %></i><span><%= t %><small><%= sub %></small></span></a><% }) %></div></div></details><% } %>
        <details class="ad-pop" data-pop>
          <summary class="ad-bell" aria-label="Notifications: <%= NOTES.length %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z"/><path d="M10 20a2 2 0 0 0 4 0"/></svg><% if (NOTES.length) { %><b><%= NOTES.length %></b><% } %></summary>
          <div class="ad-menu ad-notes"><div class="nt-h">Notifications<% if (c('enquiries')) { %><a href="/admin/enquiries">All enquiries</a><% } %></div>
            <% if (!NOTES.length) { %><p class="nt-empty">You are all caught up: nothing new.</p><% } %>
            <% NOTES.forEach(n => { %><a class="nt" href="<%= n.href %>"><i><%= n.icon %></i><span><%= n.title %><small><%= n.sub %></small></span></a><% }) %>
          </div>
        </details>
        <details class="ad-pop ad-me-top" data-pop>
          <summary><i><%= initials %></i><span><b><%= me.name %></b><small><%= R[me.role] ? R[me.role].label : '' %></small></span><svg class="um-cv" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
          <div class="ad-menu ad-usermenu">
            <div class="um-h"><i><%= initials %></i><span><b><%= me.name %></b><small><%= me.email %></small></span></div>
            <a href="/admin/account"><%- ic('user') %><span>My account<small>Name and password</small></span></a>
            <a href="/admin/look"><%- ic('look') %><span>Look of the panel<small>Light or dark, colours</small></span></a>
            <a href="/" target="_blank" rel="noopener"><%- ic('web') %><span>View the website</span></a>
            <hr><a href="/admin/logout"><%- ic('out') %><span>Log out</span></a>
          </div>
        </details>
      </div>
    </div>
