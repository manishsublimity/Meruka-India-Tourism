<%- include('_top', { pageTitle: title }) %>
<%# (26 Oct 2026, client video II) Destinations, the Travel Guide and the text tour pages: in sections, as on the website,
    each page with the pages under it. One table, numbered, no tick boxes. %>
<% const mayDelete = can('delete');
   const when = s => s ? new Date(s).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: '2-digit' }) : 'Original';
   const total = sections.reduce((n, sct) => n + (sct.head ? 1 : 0) + sct.rows.reduce((m, r) => m + 1 + r.kids.length + r.kids.reduce((k, c) => k + c.kids.length, 0), 0), 0);
   let n = 0; %>
<%# (26 Oct 2026, client) one compact header: the title, the search and one Add button; tabs only when there are regions %>
<div class="ad-top ad-head tr-top">
  <div><h1><%= title %></h1><p class="lead"><%= lead %></p></div>
  <div class="tr-acts"><input class="in lst-q" type="search" placeholder="Search a page…" data-tq><% if (mode !== 'tours') { %><button class="btn btn-g" type="button" data-add>+ Add <%= one %></button><% } %></div>
</div>
<%# (27 Oct 2026, client) no tabs: the parts one under the other, each with its name %>
<% if (false) { %>
<div class="subtabs sec-tabs" data-sectabs><% sections.forEach((sct, i) => { %><button type="button" data-sec-i="<%= i %>"<%- i === 0 ? ' class="on"' : '' %>><%= sct.title %> <b><%= sct.rows.length + sct.rows.reduce((m, r) => m + r.kids.length + r.kids.reduce((k, c) => k + c.kids.length, 0), 0) + (sct.head ? 1 : 0) %></b></button><% }) %></div>
<% } %>

<% const ov = typeof overview !== 'undefined' && overview; %>
<% if (ov) { %>
<%# (2 Nov 2026, client) Four Regions opens on the regions as cards: open a region for its pages, or edit the region page itself %>
<div class="rg-cards" data-overview>
  <% sections.forEach(sct => { const kids = sct.rows.reduce((m, r) => m + r.kids.length + r.kids.reduce((k, c) => k + c.kids.length, 0), 0), key = sct.key || 'other'; %>
  <article class="rg-card">
    <%# the region's own banner when one is chosen in its page, else the region's photo %>
    <% const rImg = sct.head && sct.head.banner && !/india-tours-main/.test(sct.head.banner) ? sct.head.banner : (sct.img || (sct.head && sct.head.img)); %>
    <a class="rg-ph" href="?region=<%= key %>"><% if (rImg) { %><img src="<%= rImg %>" alt="" loading="lazy"><% } %><span><%= sct.title %></span></a>
    <div class="rg-b">
      <p class="rg-n"><b><%= sct.rows.length %></b> <%= sct.head ? (sct.rows.length === 1 ? 'state' : 'states') : (sct.rows.length === 1 ? 'page' : 'pages') %><% if (kids) { %> · <b><%= kids %></b> <%= kids === 1 ? 'city page' : 'city pages' %><% } %></p>
      <p class="rg-s muted"><%= sct.rows.slice(0, 5).map(r => r.name.replace(/\s*Tourism$/i, '')).join(', ') %><%= sct.rows.length > 5 ? ' …' : '' %></p>
      <%# (3 Nov 2026, client) plain words: the region's own page, and the pages under it %>
      <div class="rg-acts"><% if (sct.head) { %><a class="btn btn-s btn-p" href="/admin/pages/<%= sct.head.id %>">Edit the <%= sct.title %> page</a><% } %><a class="btn btn-s" href="?region=<%= key %>"><%= sct.head ? 'States & cities' : 'Its pages' %> (<%= sct.rows.length + kids %>) →</a></div>
    </div>
  </article>
  <% }) %>
</div>
<% } %>
<% sections.forEach(sct => { n = 0; %>
<section class="tr-sec" data-sec data-title="<%= sct.title %>"<% if (sct.head) { %> data-head="<%= sct.head.id %>"<% } %><%- ov ? ' hidden' : '' %>>
  <% if (sections.length > 1) { %><h2 class="tr-sec-h" data-sec-h><%= sct.title %></h2><% } %>
  <% if (sct.head) { %><p class="rg-listcap">States and their city pages</p><% } %>
  <div class="lst-wrap">
  <table class="tbl lst lst-clean lst-cards tr-cards">
    <thead><tr><th class="n">#</th><th>Page</th><th>Status</th><th>Last change</th><th class="acts-h">Actions</th></tr></thead>
    <tbody>
      <% const row = (r, depth, parents) => { n++; %>
      <tr data-row data-s="<%= (r.name + ' ' + r.url).toLowerCase() %>" class="d<%= depth %>">
        <td class="n"><%= n %></td>
        <td><div class="lst-name"><% if (r.img) { %><img class="thumb" src="<%= r.img %>" alt="" loading="lazy"><% } %><div>
          <a href="/admin/pages/<%= r.id %>" class="row-name"><% if (depth) { %><span class="tr-branch" aria-hidden="true">↳</span><% } %><b><%= r.name %></b></a>
          <% if (r.published) { %><a href="<%= r.url %>" target="_blank" rel="noopener" class="url"><%= r.url %> ↗</a><% } else { %><span class="url"><%= r.url %></span><% } %></div></div></td>
        <td><% if (!r.published) { %><span class="pill pill-off">Draft</span><% } else if (r.hasDraft) { %><span class="pill pill-draft">Live + changes</span><% } else { %><span class="pill pill-live">Live</span><% } %></td>
        <td class="muted"><%= when(r.savedAt) %></td>
        <td class="acts"><a class="btn btn-s btn-p" href="/admin/pages/<%= r.id %>">Edit</a><% if (false) { %><button class="btn btn-s" type="button" data-add data-section="<%= sct.guideSection || '' %>" data-parents='<%- JSON.stringify((parents || []).concat([{ label: r.name, href: r.url }])).replace(/'/g, "&#39;") %>' title="Add a page under <%= r.name %>">+ Sub-page</button><% } %><% if (mode !== 'tours') { %><button class="btn btn-s" type="button" data-move="<%= r.id %>" data-url="<%= r.url %>" data-name="<%= r.name %>" data-now='<%- JSON.stringify((parents || []).map(p => p.href)).replace(/'/g, "&#39;") %>'>Move</button><% } %><% if (mayDelete) { %><button class="btn btn-s btn-d" type="button" data-del="<%= r.id %>" data-name="<%= r.name %>">Delete</button><% } %></td>
      </tr>
      <% r.kids.forEach(k => row(k, depth + 1, (parents || []).concat([{ label: r.name, href: r.url }]))); } %>
      <% sct.rows.forEach(r => row(r, 0, sct.parents || [])); %>
      <% if (!sct.rows.length) { %><tr><td colspan="5" class="muted" style="text-align:center;padding:18px">No pages here yet.</td></tr><% } %>
    </tbody>
  </table>
  </div>
</section>
<% }) %>
<script>window.TREE = { mode: <%- JSON.stringify(mode) %>, one: <%- JSON.stringify(one) %>, sections: <%- JSON.stringify(sections.map(sct => ({ title: sct.title, guideSection: sct.guideSection || '', parents: sct.parents || [], rows: (sct.rows || []).map(r => ({ label: r.name, href: r.url })) }))) %> };</script>
<%- include('_bottom', { scripts: ['/admin-assets/tree.js?v=14'] }) %>
