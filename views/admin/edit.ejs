<%
  // (23 Oct 2026) the editor: status, Preview / Save draft / Publish, and below the form: History, take off the website, delete
  const back = mode === 'single' ? (id === 'reviews' ? ['/admin/reviews', 'Guest reviews'] : singles[id] && singles[id].page ? ['/admin/pages', 'Pages'] : id === 'reviews' || id === 'header' || id === 'footer' || id === 'menus' ? ['/admin', 'Dashboard'] : ['/admin/settings', 'Site settings'])
    : kind === 'lists' ? ['/admin/lists', 'Categories']
    : kind === 'pages' ? ({ places: ['/admin/destinations', 'Destinations'], guide: ['/admin/travel-guide', 'Travel Guide'], tours: ['/admin/tours', 'Tours'] }[typeof pageGroup !== 'undefined' ? pageGroup : ''] || ['/admin/pages', 'Pages'])
    : ['/admin/' + kind, kinds[kind].label];
%>
<%- include('_top', { pageTitle: title, crumb: back }) %>
<div class="ed-head">
  <div>
    <%# (26 Oct 2026, client) the way back is in the top bar; the status sits beside the title %>
    <div class="ed-title"><h1 data-title><%= title %></h1><span class="pill" data-status>…</span><% if (mode === 'item' && (kind === 'tours' || kind === 'lists')) { %><button type="button" class="ed-code" data-code title="Give or change the tour code">…</button><% } %><span class="save-state" data-state></span></div>
    <%# (27 Oct 2026, client) the address on the server the panel runs on (localhost while testing), and a way to change it %>
    <% if (url) { %><p class="ed-url"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg><a href="<%= url %>" target="_blank" rel="noopener" data-url><span class="muted" data-host></span><span data-path><%= url %></span></a><% if (mode === 'item' && canPublish && kind !== 'lists' || (mode === 'item' && canPublish && kind === 'lists' && id !== 'itineraries')) { %><button type="button" class="lnk addr-edit" data-addr>Change address</button><% } %></p><% } %>
  </div>
  <div class="acts">
    <% if (mode === 'item') { %><a class="btn" href="/admin/preview/<%= kind %>/<%= id %>" target="_blank" rel="noopener" data-preview>Preview</a><% } else if (url) { %><a class="btn" href="<%= url %>" target="_blank" rel="noopener">View page ↗</a><% } %>
    <button class="btn" type="button" data-draft title="Save draft (Ctrl + S)">Save draft</button>
    <% if (canPublish) { %><button class="btn btn-g" type="button" data-save>Publish</button><% } %>
  </div>
</div>
<% if (!canPublish) { %><div class="pageinfo">✍️ <span>You can change this and save it as a draft. An Owner or Editor checks it and publishes it.</span></div><% } %>
<div class="pageinfo warn" data-draft-note hidden></div>

<%# (28 Oct 2026, client) the page on the left, its SEO (Google, social media, advanced) in a panel on the right, as in the SEO plugins %>
<div class="ed-split">
  <div class="ed-main">
    <div class="etabs" data-tabs></div>
    <div data-form><div class="card"><p class="hint">Loading…</p></div></div>
  </div>
  <aside class="ed-side" data-side hidden></aside>
</div>

<%# (27 Oct 2026, client) no tip box: Ctrl + S still saves a draft (shown on the Save draft button) %>
<%# (27 Oct 2026, client) the other actions: small, quiet, at the very bottom %>
<% const fi = d => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + d + '</svg>'; %>
<div class="ed-foot">
  <button class="ef" type="button" data-history><%- fi('<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5M12 7v5l3 2"/>') %>History</button>
  <button class="ef" type="button" data-discard hidden><%- fi('<path d="M18 6 6 18M6 6l12 12"/>') %>Throw away the draft</button>
  <% if (canPublish && mode === 'item') { %><button class="ef" type="button" data-unpublish hidden><%- fi('<path d="M3 3l18 18M10.6 5.1A10 10 0 0 1 22 12a10 10 0 0 1-2.3 3.2M6.6 6.6A10 10 0 0 0 2 12a10 10 0 0 0 13.4 5.4"/>') %>Take off the website</button><% } %>
  <% if (canPublish) { %><button class="ef" type="button" data-revert><%- fi('<path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/>') %>Back to the original</button><% } %>
  <% if (canDelete) { %><button class="ef ef-d" type="button" data-delete><%- fi('<path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/>') %>Delete</button><% } %>
</div>
<script>window.EDIT = { mode: <%- JSON.stringify(mode) %>, kind: <%- JSON.stringify(kind) %>, id: <%- JSON.stringify(id) %>, url: <%- JSON.stringify(url || '') %>, canPublish: <%- JSON.stringify(!!canPublish) %>, canDelete: <%- JSON.stringify(!!canDelete) %>, one: <%- JSON.stringify(mode === 'item' ? kinds[kind].one : 'section') %> };</script>
<%- include('_bottom', { scripts: ['/admin-assets/editor.js?v=28'] }) %>
