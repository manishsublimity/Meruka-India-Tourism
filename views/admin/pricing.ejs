<%- include('_top', { pageTitle: 'Prices & notes' }) %>
<%# (2 Nov 2026, client) every tour's prices, includes, excludes and important notes in one place. Tick one tour to view or
    edit it; tick several to change their prices together (by a percentage or by dollars, with a preview); each tour's
    included / excluded / notes open on their own. Changes here go live. %>
<% const codes = [...new Set(tours.map(t => String(t.code || '').split('-')[0]).filter(Boolean))]; %>
<%# (3 Nov 2026, client) the title and its line across the page; under it one bar: the search, the category and the
    number of tours on the left, the ticked tours and "Edit All Package Prices" on the right %>
<div class="ad-top ad-head pr-head2">
  <h1>Prices &amp; notes</h1>
  <p class="lead">Prices, what is included and excluded, and the notes of every tour. Changes go on the website at once.</p>
</div>
<div class="pr-bar2" data-actions>
  <div class="pr-l">
    <input class="in lst-q" type="search" placeholder="Search a tour or a code…" data-q>
    <select class="in lst-sel" data-cat><option value="">All categories</option><% codes.forEach(c => { %><option><%= c %></option><% }) %></select>
    <span class="muted pr-count" data-count><%= tours.length %> tours</span>
  </div>
  <div class="pr-r">
    <span class="pr-sel" data-sel>Tick tours to change them</span>
    <button type="button" class="btn btn-link" data-none hidden>Untick</button>
    <button type="button" class="btn btn-p" data-bulk disabled>Edit All Package Prices</button>
  </div>
</div>
<div class="lst-wrap">
<table class="tbl lst lst-clean lst-cards pr-cards">
  <thead><tr><th class="lst-ck"><input type="checkbox" data-all aria-label="Tick all the tours shown"></th><th>Tour</th><th>Price per person per day</th><th>Whole tour from</th><th>Included · Excluded · Notes</th><th class="acts-h">Actions</th></tr></thead>
  <tbody data-rows></tbody>
</table>
</div>

<%# one tour: prices and lists, in a side panel %>
<aside class="pr-drawer" data-drawer hidden aria-label="Prices and notes of a tour">
  <div class="pr-dh"><div><h2 data-dname></h2><p class="muted" data-dsub></p></div></div>
  <div class="pr-db" data-dbody></div>
  <div class="pr-df"><span class="muted" data-dnote></span><button type="button" class="btn" data-close>Cancel</button><button type="button" class="btn btn-p" data-save>Save — goes live</button></div>
</aside>
<div class="pr-scrim" data-scrim hidden></div>

<%# several tours: their prices up or down, with the old and the new price side by side before anything is saved %>
<div class="modal pr-modal" data-bulkbox hidden>
  <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="pr-bulk-h">
    <div class="modal-head"><h2 id="pr-bulk-h">Edit all package prices</h2></div>
    <%# (3 Nov 2026, client) the change as one line: up or down · how much · % or USD; what it does, in words, under it %>
    <div class="pr-bctl2">
      <label class="pr-c"><span>Change by</span><select class="in" data-mode><option value="pct">Percentage (%)</option><option value="amt">Fixed amount (USD)</option></select></label>
      <div class="pr-c"><span>Increase or decrease</span><div class="pr-seg2" role="radiogroup" aria-label="Increase or decrease"><button type="button" class="on" data-sign="1">+ Increase</button><button type="button" data-sign="-1">− Decrease</button></div></div>
      <label class="pr-c"><span>Value</span><div class="pr-val2"><input class="in" type="number" min="0" step="1" value="10" data-val><b data-unit>%</b></div></label>
    </div>
    <p class="pr-bsum" data-bsum></p>
    <div class="pr-bwrap"><table class="pr-btable"><thead><tr><th>Package</th><th>Hotel category</th><th>Price per day now</th><th>New price per day</th><th>Whole tour (new)</th></tr></thead><tbody data-brows></tbody></table></div>
    <div class="dlg-foot"><button type="button" class="btn" data-bclose>Cancel</button><button type="button" class="btn btn-p" data-bapply>Apply changes</button></div>
  </div>
</div>
<script>window.PRICING = <%- JSON.stringify(tours).replace(/</g, '\\u003c') %>;</script>
<%- include('_bottom', { scripts: ['/admin-assets/rte.js?v=1', '/admin-assets/pricing.js?v=6'] }) %>
