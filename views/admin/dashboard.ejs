<%- include('_top', { pageTitle: 'Dashboard' }) %>
<%
  // (23 Oct 2026) the start page. (6 Nov 2026, client) redone in a more modern way, with more on one screen: a banner with
  // the website's state (in Google or kept out) and quick "Add" buttons, one card for each part of the website (how many
  // are online and how many are drafts), the enquiries chart beside the newest enquiries, the Google check, what waits to
  // be published and the latest changes, and where the enquiries and the tours stand
  const hour = new Date().getHours();
  const hello = hour < 12 ? 'Good morning' : hour < 17 ? 'Good afternoon' : 'Good evening';
  const first = String(admin.name || '').split(' ')[0];
  const when = iso => { const d = new Date(iso); return isNaN(d) ? '' : d.toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }); };
  const ago = iso => { const s = (Date.now() - new Date(iso)) / 1000; if (!(s >= 0)) return ''; if (s < 60) return 'just now'; if (s < 3600) return Math.floor(s / 60) + ' min ago'; if (s < 86400) return Math.floor(s / 3600) + ' h ago'; if (s < 7 * 86400) return Math.floor(s / 86400) + ' d ago'; return when(iso); };
  const I = {
    tours: '<path d="M4 18 9 6l4 8 3-5 4 9z"/>', cats: '<path d="M4 6h16M4 12h10M4 18h7"/>', pages: '<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5"/>',
    blog: '<path d="M4 20h4L19 9l-4-4L4 16z"/>', mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>', plus: '<path d="M12 5v14M5 12h14"/>',
    photo: '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 8"/>', google: '<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>',
    clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>', pen: '<path d="M4 20h4L19 9l-4-4L4 16z"/><path d="m13 7 4 4"/>', eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
    off: '<path d="M3 3l18 18"/><path d="M10.6 5.1A10 10 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3.1 4M6.6 6.6A17 17 0 0 0 2 12s3.5 7 10 7a9.7 9.7 0 0 0 5.4-1.6"/>', arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>'
  };
  const ic = n => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + I[n] + '</svg>';
  const L = typeof live !== 'undefined' ? live : {};
  // [permission, link, icon, all, online, name, colour]
  const CARDS = [
    ['content', '/admin/tours', 'tours', counts.tours, L.tours, 'Tours', 'blue'],
    ['content', '/admin/lists', 'cats', counts.lists, L.lists, 'Tour categories', 'teal'],
    ['content', '/admin/destinations', 'pages', counts.pages, L.pages, 'Pages', 'violet'],
    ['content', '/admin/posts', 'blog', counts.posts, L.posts, 'Blog posts', 'gold']
  ].filter(x => can(x[0]) && x[3] !== undefined);
  const ADD = [['content', '/admin/tours#new', 'Tour'], ['content', '/admin/lists#new', 'Category'], ['content', '/admin/destinations#new', 'Destination'], ['content', '/admin/posts#new', 'Blog post'], ['content', '/admin/media', 'Photos']].filter(x => can(x[0]));
  const seoPct = seoStats.total ? Math.round(seoStats.good / seoStats.total * 100) : 0;
%>
<section class="dx-hero">
  <div class="dx-hi">
    <p class="dx-date"><%= new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></p>
    <h1><%= hello %><%= first ? ', ' + first : '' %></h1>
    <p class="dx-say"><% if (can('enquiries')) { %><b><%= newEnquiries %></b> new <%= newEnquiries === 1 ? 'enquiry' : 'enquiries' %> waiting<% if (typeof enqWeek !== 'undefined') { %> · <b><%= enqWeek %></b> this week<% } %><% } %><% if (can('content')) { %><%= can('enquiries') ? ' · ' : '' %><b><%= drafts.length %></b> waiting to be published<% } %></p>
    <% if (can('settings')) { %>
    <a class="dx-state <%= paused ? 'off' : 'on' %>" href="/admin/settings/seo"><%- ic(paused ? 'off' : 'eye') %><span><b><%= paused ? 'Kept out of Google' : 'Open to Google' %></b><small><%= paused ? 'Every page has “noindex”. Change it in Google settings → Search engines.' : 'Search engines can find the website.' %></small></span></a>
    <% } %>
  </div>
  <% if (ADD.length) { %>
  <div class="dx-add"><span class="dx-add-t">Add new</span>
    <div class="dx-add-g"><% ADD.forEach(([, href, t]) => { %><a href="<%= href %>"><%- ic(t === 'Photos' ? 'photo' : 'plus') %><%= t === 'Photos' ? 'Upload photos' : t %></a><% }) %></div>
  </div>
  <% } %>
</section>

<div class="dx-cards">
  <% CARDS.forEach(([, href, icon, all, on, label, col]) => { const pct = all ? Math.round((on || 0) / all * 100) : 0; %>
  <a class="dx-card c-<%= col %>" href="<%= href %>">
    <span class="dx-ic"><%- ic(icon) %></span>
    <span class="dx-n"><b><%= all %></b><em><%= label %></em></span>
    <span class="dx-bar" title="<%= on || 0 %> online"><i style="width:<%= pct %>%"></i></span>
    <small><b><%= on || 0 %></b> online<% if (all - (on || 0) > 0) { %> · <%= all - (on || 0) %> not online<% } %></small>
  </a>
  <% }) %>
  <% if (typeof photos !== 'undefined' && photos) { %>
  <a class="dx-card c-rose" href="/admin/media"><span class="dx-ic"><%- ic('photo') %></span><span class="dx-n"><b><%= photos.all %></b><em>Photos</em></span><span class="dx-bar"><i style="width:<%= photos.all ? Math.max(2, Math.round(photos.uploaded / photos.all * 100)) : 0 %>%"></i></span><small><b><%= photos.uploaded %></b> uploaded in the panel</small></a>
  <% } %>
  <% if (can('enquiries')) { %>
  <a class="dx-card c-red<%= newEnquiries ? ' hot' : '' %>" href="/admin/enquiries"><span class="dx-ic"><%- ic('mail') %></span><span class="dx-n"><b><%= newEnquiries %></b><em>New enquiries</em></span><span class="dx-bar"><i style="width:<%= typeof enqTotal !== 'undefined' && enqTotal ? Math.round(newEnquiries / enqTotal * 100) : 0 %>%"></i></span><small><%= newEnquiries ? 'Waiting for a reply' : 'All answered' %><% if (typeof enqTotal !== 'undefined') { %> · <%= enqTotal %> in all<% } %></small></a>
  <% } %>
</div>

<% if (can('enquiries')) { %>
<div class="dx-grid dx-g-main">
  <div class="card dc dx-panel">
    <div class="dc-h"><h2><%- ic('mail') %>Enquiries <span class="ch-big" data-k="count">–</span></h2>
      <div class="seg seg-s" data-range><button type="button" data-d="7">7 d</button><button type="button" data-d="30" aria-pressed="true">30 d</button><button type="button" data-d="90">90 d</button><button type="button" data-d="365">12 m</button><button type="button" data-d="0">All</button></div></div>
    <p class="sub" data-k="timeSub"></p><div data-c="time"></div>
  </div>
  <div class="card dc dx-panel dc-latest">
    <div class="dc-h"><h2>Latest enquiries</h2><a href="/admin/enquiries">See all <%- ic('arrow') %></a></div>
    <div class="dl-box"><div class="dl-list">
    <% if (!latest.length) { %><p class="hint">No enquiries yet.</p><% } %>
    <% latest.forEach(e => { %>
    <a class="dl-row" href="/admin/enquiries"><i aria-hidden="true"><%= String(e.name || '?').trim().charAt(0).toUpperCase() %></i><span><b><%= e.name %></b><small><%= [e.country, e.travellers ? e.travellers + ' travellers' : '', e.duration].filter(Boolean).join(' · ') || e.email %></small></span><span class="dl-r"><span class="pill <%= e._st === 'New' ? 'pill-new' : 'pill-live' %>"><%= e._st %></span><small><%= ago(e.receivedAt) %></small></span></a>
    <% }) %>
    </div></div>
  </div>
</div>
<% } %>

<% if (can('content')) { %>
<div class="dx-grid dx-g-3">
  <div class="card dc dx-panel">
    <div class="dc-h"><h2><%- ic('google') %>Google check</h2><a href="/admin/seo">Open <%- ic('arrow') %></a></div>
    <div class="dx-ring" style="--p:<%= seoPct %>"><b><%= seoPct %>%</b><small>pages ready</small></div>
    <ul class="dx-legend">
      <li class="g"><i></i>Good<b><%= seoStats.good %></b></li>
      <li class="o"><i></i>Could be better<b><%= seoStats.ok %></b></li>
      <li class="b"><i></i>Needs attention<b><%= seoStats.bad %></b></li>
    </ul>
  </div>
  <div class="card dc dx-panel">
    <div class="dc-h"><h2><%- ic('clock') %>Waiting to be published <span class="ch-big"><%= drafts.length %></span></h2></div>
    <% if (!drafts.length) { %><p class="dx-empty">Nothing waiting. Everything is on the website.</p><% } %>
    <div class="dx-scroll">
    <% drafts.slice(0, 12).forEach(d => { %>
    <a class="row-link" href="<%= d.kind === 'single' ? '/admin/settings/' + d.id : '/admin/' + d.kind + '/' + d.id %>"><span><b><%= d.name %></b><small><%= d.one.charAt(0).toUpperCase() + d.one.slice(1) %> · <%= d.published ? 'live, with changes' : 'not on the website yet' %></small></span><span class="pill <%= d.published ? 'pill-draft' : 'pill-off' %>"><%= d.published ? 'Changes' : 'Draft' %></span></a>
    <% }) %>
    </div>
  </div>
  <div class="card dc dx-panel">
    <div class="dc-h"><h2><%- ic('pen') %>Latest changes</h2><% if (can('users')) { %><a href="/admin/activity">All <%- ic('arrow') %></a><% } %></div>
    <% if (!recent.length) { %><p class="dx-empty">No changes yet.</p><% } %>
    <ol class="dx-feed">
      <% recent.forEach(a => { %>
      <li><i aria-hidden="true"><%= String(a.by || '?').trim().charAt(0).toUpperCase() %></i><span><% if (a.link) { %><a href="<%= a.link %>"><b><%= a.action %></b> <%= a.what %></a><% } else { %><b><%= a.action %></b> <%= a.what %><% } %><small><%= a.by %> · <%= ago(a.at) %></small></span></li>
      <% }) %>
    </ol>
  </div>
</div>
<% } %>

<% if (can('enquiries') || can('content')) { %>
<div class="dx-grid dx-g-2">
  <% if (can('enquiries')) { %>
  <div class="card dc dx-panel">
    <div class="dc-h"><h2>Enquiries at a glance</h2><span class="muted" data-k="rangeName"></span></div>
    <div class="st-tiles" data-c="status"></div>
    <h3 class="dc-sub">Where travellers come from</h3>
    <div data-c="country"></div>
  </div>
  <% } %>
  <% if (can('content')) { %>
  <div class="card dc dx-panel"><div class="dc-h"><h2><%- ic('tours') %>Tours by region</h2><a href="/admin/tours">All tours <%- ic('arrow') %></a></div><div data-c="groups"></div></div>
  <% } %>
</div>
<% } %>
<%- include('_bottom', { scripts: ['/admin-assets/charts.js?v=1', '/admin-assets/dash.js?v=4'] }) %>
