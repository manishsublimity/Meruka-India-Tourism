<%- include('_top', { pageTitle: 'Dashboard' }) %>
<%
  // (23 Oct 2026) the start page. (26 Oct 2026, client) redone so nothing stands empty: the numbers in one row, the enquiry
  // chart beside the newest enquiries, three small charts in one row, then what waits and what changed — each card only
  // as tall as what it holds
  const hour = new Date().getHours();
  const hello = hour < 12 ? 'Good morning' : hour < 17 ? 'Good afternoon' : 'Good evening';
  const first = String(admin.name || '').split(' ')[0];
  const when = iso => { const d = new Date(iso); return isNaN(d) ? '' : d.toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }); };
  const I = {
    tours: '<path d="M4 18 9 6l4 8 3-5 4 9z"/>', cats: '<path d="M4 6h16M4 12h10M4 18h7"/>', pages: '<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5"/>',
    blog: '<path d="M4 20h4L19 9l-4-4L4 16z"/>', mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>', plus: '<path d="M12 5v14M5 12h14"/>'
  };
  const ic = n => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + I[n] + '</svg>';
  const STATS = [
    ['content', '/admin/tours', 'tours', counts.tours, 'Tours', 'Online and drafts'],
    ['content', '/admin/lists', 'cats', counts.lists, 'Tour categories', 'Pages that list tours'],
    ['content', '/admin/destinations', 'pages', counts.pages, 'Pages', 'Destinations and guide'],
    ['enquiries', '/admin/enquiries', 'mail', newEnquiries, 'New enquiries', newEnquiries ? 'Waiting for a reply' : 'All answered']
  ].filter(x => can(x[0]));
  const ACTIONS = [['content', '/admin/tours#new', 'Add a tour'], ['content', '/admin/lists#new', 'Add a category'], ['enquiries', '/admin/enquiries', 'Enquiries']].filter(x => can(x[0]));
%>
<div class="dh">
  <div><h1><%= hello %><%= first ? ', ' + first : '' %></h1><p class="lead">Signed in as <b><%= roles[admin.role].label %></b>.</p></div>
  <div class="dh-acts"><% ACTIONS.forEach(([, href, t], i) => { %><a class="btn<%= i === 0 ? ' btn-p' : '' %>" href="<%= href %>"><%- i < 2 ? ic('plus') : '' %><%= t %></a><% }) %></div>
</div>

<div class="ds">
  <% STATS.forEach(([, href, icon, n, label, sub]) => { %>
  <a class="ds-i<%= icon === 'mail' && n ? ' hot' : '' %>" href="<%= href %>"><i><%- ic(icon) %></i><span><b><%= n %></b><em><%= label %></em><small><%= sub %></small></span></a>
  <% }) %>
</div>

<% if (can('enquiries') || can('content')) { %>
<div class="dg">
  <% if (can('enquiries')) { %>
  <div class="card dc dc-wide">
    <div class="dc-h"><h2>Enquiries <span class="ch-big" data-k="count">–</span></h2>
      <div class="seg seg-s" data-range><button type="button" data-d="7">7 d</button><button type="button" data-d="30" aria-pressed="true">30 d</button><button type="button" data-d="90">90 d</button><button type="button" data-d="365">12 m</button><button type="button" data-d="0">All</button></div></div>
    <p class="sub" data-k="timeSub"></p><div data-c="time"></div>
  </div>
  <div class="card dc">
    <div class="dc-h"><h2>Latest enquiries</h2><a href="/admin/enquiries">All</a></div>
    <% if (!latest.length) { %><p class="hint">No enquiries yet.</p><% } %>
    <% latest.forEach(e => { %>
    <a class="row-link" href="/admin/enquiries"><span><b><%= e.name %></b><small><%= when(e.receivedAt) %><%= e.country ? ' · ' + e.country : '' %></small></span><span class="pill <%= e._st === 'New' ? 'pill-new' : 'pill-live' %>"><%= e._st %></span></a>
    <% }) %>
  </div>
  <div class="card dc"><div class="dc-h"><h2>Where each enquiry stands</h2></div><div data-c="status"></div></div>
  <div class="card dc"><div class="dc-h"><h2>Where travellers come from</h2></div><div data-c="country"></div></div>
  <% } %>
  <% if (can('content')) { %>
  <div class="card dc"><div class="dc-h"><h2>Tours by region</h2></div><div data-c="groups"></div></div>
  <% } %>
</div>
<% } %>

<div class="dg <%= can('content') && drafts.length ? 'dg-2' : 'dg-1' %>">
  <% if (can('content') && drafts.length) { %>
  <div class="card dc" id="waiting">
    <div class="dc-h"><h2>Waiting to be published <span class="ch-big"><%= drafts.length %></span></h2></div>
    <% drafts.slice(0, 6).forEach(d => { %>
    <a class="row-link" href="<%= d.kind === 'single' ? '/admin/settings/' + d.id : '/admin/' + d.kind + '/' + d.id %>"><span><b><%= d.name %></b><small><%= d.one.charAt(0).toUpperCase() + d.one.slice(1) %> · <%= d.published ? 'live, with changes' : 'not on the website yet' %></small></span><span class="pill <%= d.published ? 'pill-draft' : 'pill-off' %>"><%= d.published ? 'Changes' : 'Draft' %></span></a>
    <% }) %>
  </div>
  <% } %>
  <div class="card dc">
    <div class="dc-h"><h2>Recent changes<% if (can('content') && !drafts.length) { %> <small class="muted dc-ok">· nothing waiting to be published</small><% } %></h2><% if (can('users')) { %><a href="/admin/activity">Activity log</a><% } %></div>
    <% if (!recent.length) { %><p class="hint dc-empty">Changes made in the panel show here.</p><% } %>
    <div class="rc-list"><% recent.slice(0, 6).forEach(a => { %>
    <a class="row-link" href="<%= a.link || '#' %>"><span><b><%= a.action %> <%= a.what %></b><small><%= a.by %> · <%= when(a.at) %></small></span></a>
    <% }) %></div>
  </div>
</div>
<%- include('_bottom', { scripts: ['/admin-assets/charts.js?v=1', '/admin-assets/dash.js?v=2'] }) %>
