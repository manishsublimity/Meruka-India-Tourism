<%- include('_top', { pageTitle: 'Activity log' }) %>
<%# (23 Oct 2026) who changed what, and when (the latest 500); Owners only %>
<div class="ad-top ad-head">
  <div>
    <h1>Activity log</h1>
    <p class="lead">Every change made in the panel: who did it and when. Click a line to open what was changed.</p>
  </div>
</div>
<div class="lst-bar">
  <div class="lst-left">
    <select class="in lst-sel" data-who aria-label="Filter by person">
      <option value="">Everyone</option>
      <% [...new Set(items.map(a => a.by))].filter(Boolean).forEach(n => { %><option><%= n %></option><% }) %>
    </select>
  </div>
  <div class="lst-right"><input class="in lst-q" type="search" placeholder="Search the log…" data-q></div>
</div>
<div class="lst-wrap">
<table class="tbl lst">
  <thead><tr><th>When</th><th>Who</th><th>What happened</th></tr></thead>
  <tbody>
    <% if (!items.length) { %><tr><td colspan="3" class="muted">Nothing yet. Changes made in the panel show here.</td></tr><% } %>
    <% items.forEach(a => { %>
    <tr data-row data-by="<%= a.by %>" data-s="<%= (a.by + ' ' + a.action + ' ' + a.what).toLowerCase() %>">
      <td class="muted" style="white-space:nowrap"><%= new Date(a.at).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
      <td><b><%= a.by %></b></td>
      <td><%= a.action %> <% if (a.link) { %><a href="<%= a.link %>"><%= a.what %></a><% } else { %><%= a.what %><% } %></td>
    </tr>
    <% }) %>
  </tbody>
</table>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const rows = [...document.querySelectorAll('[data-row]')], q = document.querySelector('[data-q]'), who = document.querySelector('[data-who]');
  const pager = window.ADMIN.pager(rows, document.querySelector('.lst-wrap'), 30);
  const run = () => { const v = q.value.trim().toLowerCase(), w = who.value; rows.forEach(r => { r.dataset.out = (v && !r.dataset.s.includes(v)) || (w && r.dataset.by !== w) ? '1' : ''; }); pager.update(true); };
  q.oninput = run; who.onchange = run;
});
</script>
<%- include('_bottom') %>
