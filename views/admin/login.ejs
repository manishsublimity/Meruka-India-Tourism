<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Log in — Meruka admin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700&family=Instrument+Serif:ital@1&family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/admin-assets/admin.css?v=37">
</head>
<body>
<div class="login">
  <aside class="login-art">
    <img src="/photos/hero-taj-mahal.webp" alt="">
    <div class="login-brand"><span class="lg-logo" aria-hidden="true"></span><span><b>MERUKA INDIA TOURISM</b><small>Website editor</small></span></div>
    <div class="login-say">
      <h2>One country, <em>many worlds.</em></h2>
      <p>Tours, pages, blog and enquiries — all in one place.</p>
    </div>
  </aside>
  <main class="login-side">
    <form class="login-form" method="post" action="/admin/login">
      <%# (27 Oct 2026, client) one logo only, on the photo; this one shows only on phones, where the photo is hidden %>
      <div class="login-brand lg-top lg-phone"><span class="lg-logo" aria-hidden="true"></span><span><b>MERUKA INDIA TOURISM</b><small>Website editor</small></span></div>
      <h1>Sign in to your <em>editor</em></h1>
      <p class="hint">Manage tours, destinations, the travel guide and enquiries for Meruka India Tourism.</p>
      <% if (error) { %><div class="err"><%= error %></div><% } %>
      <% if (!closed) { %>
      <input type="hidden" name="next" value="<%= next %>">
      <div class="f"><label class="lb" for="u">Email</label>
        <div class="login-in"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><input class="in" id="u" name="user" autocomplete="username" placeholder="you@example.com" required autofocus></div></div>
      <div class="f"><label class="lb" for="p">Password</label>
        <div class="login-in"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg><input class="in" id="p" name="password" type="password" autocomplete="current-password" placeholder="Your password" required>
          <button type="button" class="login-eye" data-eye aria-label="Show password" aria-pressed="false">
            <svg data-open viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
            <svg data-shut hidden viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.6 5.1A10.6 10.6 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-2.6 3.5M6.6 6.6A17.4 17.4 0 0 0 2 12s3.5 7 10 7a9.7 9.7 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2M3 3l18 18"/></svg>
          </button>
        </div>
        <small class="login-caps" data-caps hidden>Caps Lock is on</small>
      </div>
      <button class="btn btn-p login-go">Log in</button>
      <% } %>
      <a class="login-back" href="/">← Back to the website</a>
    </form>
  </main>
  <footer class="login-foot">© <%= new Date().getFullYear() %> Meruka India Tourism Service. All rights reserved.</footer>
</div>
<script>
(function () {
  var p = document.getElementById('p'), b = document.querySelector('[data-eye]'), caps = document.querySelector('[data-caps]');
  if (!p || !b) return;
  b.onclick = function () {
    var show = p.type === 'password';
    p.type = show ? 'text' : 'password';
    b.setAttribute('aria-pressed', show); b.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
    b.querySelector('[data-open]').hidden = show; b.querySelector('[data-shut]').hidden = !show;
    p.focus();
  };
  p.addEventListener('keyup', function (e) { if (e.getModifierState) caps.hidden = !e.getModifierState('CapsLock'); });
})();
</script>
</body>
</html>
