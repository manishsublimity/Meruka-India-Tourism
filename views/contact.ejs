<%- include('partials/head') %>
<%
  // Contact us (18 Oct 2026, client): the head office on the left as the client wrote it, the other offices on the
  // right; below them the home page's small "Plan Your Trip" form (its heading 20% smaller here); then one slim band
  // with a button to the tour packages. No other sections — the header and footer carry the rest.
  const hq = d.hqBlock, others = d.offices.slice(1);
  const telOf = p => 'tel:' + String(p).replace(/[^0-9+]/g, '');
%>
<div style="width:100%;overflow-x:clip;background:#fff">
<div id="mk-frame" class="<%= typeof frameClass !== 'undefined' ? frameClass : '' %>" style="container-type:inline-size;width:100%;background:#fff">

<%- include('partials/page-header', { nav: d.nav, enquireHref: '#plan' }) %>
<%- include('partials/photo-hero', { title: 'Contact Us', img: d.heroSrc, alt: 'A camel caravan crossing the Thar desert at sunset', sub: 'Thanks for visiting our web site. Please send us the following information, enabling us to design the best tour for you.' }) %>

<section class="ct2">
  <div class="ex-wrap ct2-grid">
    <div class="ct2-hq">
      <p class="ct2-city"><%= hq.city %></p>
      <address>
        <b><%= hq.name %></b>
        <% hq.lines.forEach(l => { %><span><%= l %></span><% }) %>
        <span>Cell: <a href="<%= telOf('+91' + hq.cell) %>"><%= hq.cell %></a>. Landline <a href="<%= telOf('+91' + hq.landline.replace(/^0/, '')) %>"><%= hq.landline %></a>.</span>
        <span>E-mail: <a href="mailto:<%= hq.email %>"><%= hq.email %></a></span>
        <span>Gmail-id: <a href="mailto:<%= hq.gmail %>"><%= hq.gmail %></a></span>
        <span>Website: <a href="/"><%= hq.website %></a></span>
      </address>
    </div>
    <div class="ct2-others">
      <h2 class="ct2-h">Other offices</h2>
      <div class="ct2-list">
        <% others.forEach(o => { %>
        <div class="ct2-off">
          <p class="ct2-oc"><%= o.city %></p>
          <p><%= o.lines.join(' ') %></p>
          <% if (o.phones.length) { %><p><% o.phones.forEach((p, i) => { %><a href="<%= telOf(p) %>"><%= p %></a><%= i < o.phones.length - 1 ? ', ' : '' %><% }) %></p><% } %>
          <% if (o.email) { %><p><a href="mailto:<%= o.email %>"><%= o.email %></a></p><% } %>
        </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<section id="plan" class="pv pz ct2-plan">
<%- include('partials/plan-form', { P: H }) %>
</section>

<section class="ct2-band-sec">
  <div class="ex-wrap">
    <div class="pop-band-in">
      <p class="pop-band-t">Our tour <em>packages</em><span>Private tours of India — see every itinerary.</span></p>
      <a href="/itineraries" class="ph-btn ph-btn-gold">View our tour packages <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<%- include('partials/page-footer', { footCols: d.footCols, enquireHref: '#plan' }) %>

</div>
</div>
<script src="/js/home-2.js" defer></script>
</body>
</html>
